<!-- TOAST -->
<div class="toast" id="toast"></div>

<style>
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}
</style>

<script>
// ═══════════════════════════════════════
// DATA
// ═══════════════════════════════════════
const EXERCISES = [
  { id:1, name:'Course à pied',    type:'Cardio',     icon:'🏃', cal:400, video:'dQw4w9WgXcQ', muscles:'Jambes, Cardio' },
  { id:2, name:'Vélo stationnaire',type:'Cardio',     icon:'🚴', cal:350, video:'dQw4w9WgXcQ', muscles:'Quadriceps, Cardio' },
  { id:3, name:'Corde à sauter',   type:'HIIT',       icon:'⚡', cal:500, video:'dQw4w9WgXcQ', muscles:'Full body, Cardio' },
  { id:4, name:'Squat',            type:'Musculation',icon:'🦵', cal:200, video:'dQw4w9WgXcQ', muscles:'Quadriceps, Fessiers' },
  { id:5, name:'Développé couché', type:'Musculation',icon:'💪', cal:180, video:'dQw4w9WgXcQ', muscles:'Pectoraux, Triceps' },
  { id:6, name:'Tractions',        type:'Musculation',icon:'🏋', cal:150, video:'dQw4w9WgXcQ', muscles:'Dos, Biceps' },
  { id:7, name:'Yoga Soleil',      type:'Yoga',       icon:'🌅', cal:120, video:'dQw4w9WgXcQ', muscles:'Flexibilité, Core' },
  { id:8, name:'Planche',          type:'Pilates',    icon:'🧘', cal:80,  video:'dQw4w9WgXcQ', muscles:'Core, Épaules' },
  { id:9, name:'Burpees',          type:'HIIT',       icon:'🔥', cal:450, video:'dQw4w9WgXcQ', muscles:'Full body' },
  { id:10,name:'Rowing',           type:'Musculation',icon:'🚣', cal:220, video:'dQw4w9WgXcQ', muscles:'Dos, Biceps, Core' },
  { id:11,name:'Natation',         type:'Cardio',     icon:'🏊', cal:380, video:'dQw4w9WgXcQ', muscles:'Full body' },
  { id:12,name:'Pilates Mat',      type:'Pilates',    icon:'🌸', cal:140, video:'dQw4w9WgXcQ', muscles:'Core, Dos, Hanches' },
];

const CAT_COLORS = { Cardio:'cardio', Musculation:'muscu', Yoga:'yoga', HIIT:'hiit', Pilates:'pilates' };

let sessions = JSON.parse(localStorage.getItem('harmony_sessions') || '[]');
let selectedExercise = null;
let currentFilter = 'all';
let editingId = null;

const AI_RESPONSES = {
  default: [
    "Pour progresser en musculation, concentrez-vous sur la surcharge progressive : augmentez le poids ou les répétitions chaque semaine. 💪",
    "La récupération est aussi importante que l'entraînement ! Dormez 7-9h par nuit et reposez-vous 48h entre deux séances du même groupe musculaire.",
    "Pour perdre du poids efficacement, combinez HIIT (20-30 min) 3x/semaine avec une alimentation légèrement déficitaire en calories.",
    "L'hydratation est cruciale : buvez 500ml d'eau avant l'entraînement, et 150-250ml toutes les 15-20 minutes pendant l'effort.",
    "Pour le cardio, maintenez une fréquence cardiaque entre 60-80% de votre max. Formule : 220 - votre âge. 🏃",
  ],
  squat:  "Le squat est roi ! Pour la technique : pieds écartés largeur d'épaules, dos droit, genoux dans l'axe des pieds. Descendez jusqu'à 90° minimum. 🦵",
  cardio: "Pour maximiser vos séances cardio, alternez HIIT (intervalles courts et intenses) avec du cardio modéré (Zone 2). Le Zone 2 améliore l'endurance de base. ❤️",
  nutrition: "Avant l'entraînement : glucides complexes 1-2h avant. Après : protéines + glucides dans les 30 minutes pour optimiser la récupération. 🥗",
  repos: "Le repos actif est parfait les jours de récupération : marche légère, stretching ou yoga. Évitez l'inactivité totale et les séances intenses 2 jours consécutifs.",
  motivation: "La constance bat l'intensité ! Une séance modérée 5x/semaine > une séance intense 1x/semaine. Fixez-vous de petits objectifs hebdomadaires. 🎯",
};

// ═══════════════════════════════════════
// INIT
// ═══════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('sessionDate').value = today();
  document.getElementById('dateSeance').value = today();
  renderExercises('all');
  renderHistory();
  updateStats();
  animateBodyViz();

  // Category filter buttons
  document.querySelectorAll('.cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.cat;
      renderExercises(currentFilter);
    });
  });

  // Log form submit
  document.getElementById('logForm').addEventListener('submit', handleLogSubmit);

  // Edit form submit
  document.getElementById('editForm').addEventListener('submit', handleEditSubmit);

  // Avatar dropdown
  const avatarBtn = document.getElementById('avatarBtn');
  const profileDropdown = document.getElementById('profileDropdown');
  avatarBtn.addEventListener('click', e => { e.stopPropagation(); profileDropdown.classList.toggle('open'); });
  document.addEventListener('click', () => profileDropdown.classList.remove('open'));

  // Close modals on overlay click
  document.querySelectorAll('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', e => { if(e.target === overlay) closeModal(overlay.id); });
  });
});

function today() {
  return new Date().toISOString().split('T')[0];
}

// ═══════════════════════════════════════
// EXERCISES RENDER
// ═══════════════════════════════════════
function renderExercises(filter) {
  const grid = document.getElementById('exerciseGrid');
  const list = filter === 'all' ? EXERCISES : EXERCISES.filter(e => e.type === filter);
  if (!list.length) { grid.innerHTML = '<div class="empty"><div class="empty-icon">🔍</div><div class="empty-text">Aucun exercice dans cette catégorie</div></div>'; return; }

  grid.innerHTML = list.map(ex => `
    <div class="ex-card ${selectedExercise?.id === ex.id ? 'selected' : ''}" data-id="${ex.id}" onclick="selectExercise(${ex.id})">
      <div class="ex-thumb">
        <div class="ex-thumb-bg"></div>
        <span style="position:relative;z-index:1">${ex.icon}</span>
        <span class="ex-badge ${CAT_COLORS[ex.type] || ''}">${ex.type}</span>
      </div>
      <div class="ex-body">
        <div class="ex-name">${ex.name}</div>
        <div class="ex-cal">🔥 ~${ex.cal} kcal/h</div>
      </div>
      <div class="ex-actions">
        <button class="btn-xs v" onclick="event.stopPropagation();openVideo(${ex.id})">▶ Vidéo</button>
        <button class="btn-xs q" onclick="event.stopPropagation();openQR(${ex.id})">📱 QR</button>
      </div>
    </div>
  `).join('');
}

function selectExercise(id) {
  selectedExercise = EXERCISES.find(e => e.id === id);
  document.getElementById('exerciseId').value = id;

  const info = document.getElementById('selectedInfo');
  info.classList.add('show');
  document.getElementById('selectedIcon').textContent = selectedExercise.icon;
  document.getElementById('selectedName').textContent = selectedExercise.name;
  document.getElementById('selectedType').textContent = selectedExercise.type + ' · ' + selectedExercise.muscles;

  // Update body viz
  document.getElementById('bodyViz').textContent = selectedExercise.icon;
  document.getElementById('muscleLabel').textContent = '🎯 ' + selectedExercise.muscles;

  // Auto-fill calories estimate
  const duree = parseInt(document.getElementById('duree').value) || 0;
  if (duree > 0) {
    document.getElementById('calories').value = Math.round(selectedExercise.cal * duree / 60);
  }

  renderExercises(currentFilter);
  showToast('info', selectedExercise.icon + ' ' + selectedExercise.name + ' sélectionné');
}

// ═══════════════════════════════════════
// CRUD — LOG
// ═══════════════════════════════════════
function handleLogSubmit(e) {
  e.preventDefault();
  let valid = true;

  const exerciseId = parseInt(document.getElementById('exerciseId').value);
  if (!exerciseId) { showToast('error', 'Veuillez sélectionner un exercice !'); return; }

  const duree = parseInt(document.getElementById('duree').value);
  const dureeField = document.getElementById('duree');
  const errDuree = document.getElementById('err-duree');
  if (!duree || duree < 1 || duree > 300) {
    dureeField.classList.add('error'); errDuree.classList.add('show'); valid = false;
  } else {
    dureeField.classList.remove('error'); errDuree.classList.remove('show');
  }

  const dateSeance = document.getElementById('dateSeance').value;
  const dateField = document.getElementById('dateSeance');
  const errDate = document.getElementById('err-date');
  if (!dateSeance) {
    dateField.classList.add('error'); errDate.classList.add('show'); valid = false;
  } else {
    dateField.classList.remove('error'); errDate.classList.remove('show');
  }

  if (!valid) { showToast('error', 'Veuillez corriger les erreurs.'); return; }

  const ex = EXERCISES.find(e => e.id === exerciseId);
  const session = {
    id: Date.now(),
    exerciseId,
    exerciseName: ex.name,
    exerciseIcon: ex.icon,
    exerciseType: ex.type,
    duree,
    calories: parseInt(document.getElementById('calories').value) || Math.round(ex.cal * duree / 60),
    series: parseInt(document.getElementById('series').value) || null,
    reps: parseInt(document.getElementById('reps').value) || null,
    poids: parseFloat(document.getElementById('poids').value) || null,
    notes: document.getElementById('notes').value.trim(),
    date: dateSeance,
  };

  sessions.unshift(session);
  saveAndRefresh();

  // Reset
  document.getElementById('logForm').reset();
  document.getElementById('dateSeance').value = today();
  document.getElementById('exerciseId').value = '';
  document.getElementById('selectedInfo').classList.remove('show');
  selectedExercise = null;
  renderExercises(currentFilter);

  showToast('success', '✅ Séance enregistrée avec succès !');
}

// ═══════════════════════════════════════
// CRUD — EDIT
// ═══════════════════════════════════════
function openEdit(id) {
  const s = sessions.find(s => s.id === id);
  if (!s) return;
  editingId = id;
  document.getElementById('editId').value = id;
  document.getElementById('editDuree').value = s.duree;
  document.getElementById('editCalories').value = s.calories || '';
  document.getElementById('editSeries').value = s.series || '';
  document.getElementById('editReps').value = s.reps || '';
  document.getElementById('editNotes').value = s.notes || '';
  openModal('editModal');
}

function handleEditSubmit(e) {
  e.preventDefault();
  const duree = parseInt(document.getElementById('editDuree').value);
  const errDuree = document.getElementById('err-edit-duree');
  if (!duree || duree < 1 || duree > 300) {
    document.getElementById('editDuree').classList.add('error');
    errDuree.classList.add('show'); return;
  }
  document.getElementById('editDuree').classList.remove('error');
  errDuree.classList.remove('show');

  const idx = sessions.findIndex(s => s.id === editingId);
  if (idx === -1) return;
  sessions[idx] = {
    ...sessions[idx],
    duree,
    calories: parseInt(document.getElementById('editCalories').value) || sessions[idx].calories,
    series: parseInt(document.getElementById('editSeries').value) || null,
    reps: parseInt(document.getElementById('editReps').value) || null,
    notes: document.getElementById('editNotes').value.trim(),
  };

  saveAndRefresh();
  closeModal('editModal');
  showToast('success', '✏️ Séance modifiée !');
}

// ═══════════════════════════════════════
// CRUD — DELETE
// ═══════════════════════════════════════
function deleteSession(id) {
  if (!confirm('Supprimer cette séance ?')) return;
  sessions = sessions.filter(s => s.id !== id);
  saveAndRefresh();
  showToast('error', '🗑 Séance supprimée');
}

// ═══════════════════════════════════════
// RENDER HISTORY
// ═══════════════════════════════════════
function renderHistory() {
  const list = document.getElementById('histList');
  document.getElementById('histCount').textContent = sessions.length + ' séance' + (sessions.length !== 1 ? 's' : '');

  if (!sessions.length) {
    list.innerHTML = '<div class="empty"><div class="empty-icon">📋</div><div class="empty-text">Aucune séance enregistrée.<br>Commencez dès maintenant !</div></div>';
    return;
  }

  list.innerHTML = sessions.map(s => `
    <div class="hist-item" style="animation:fadeUp .35s ease both">
      <div class="hist-icon">${s.exerciseIcon}</div>
      <div class="hist-info">
        <div class="hist-name">${s.exerciseName}</div>
        <div class="hist-meta">
          <span class="hist-tag">⏱ ${s.duree} min</span>
          ${s.calories ? `<span class="hist-tag">🔥 ${s.calories} kcal</span>` : ''}
          ${s.series ? `<span class="hist-tag">✖ ${s.series} × ${s.reps || '?'}</span>` : ''}
          ${s.poids ? `<span class="hist-tag">⚖ ${s.poids} kg</span>` : ''}
          <span class="hist-tag">📅 ${formatDate(s.date)}</span>
        </div>
        ${s.notes ? `<div style="font-size:11.5px;color:var(--tx-muted);margin-top:4px;font-style:italic">"${s.notes}"</div>` : ''}
      </div>
      <div class="hist-actions">
        <button class="btn-icon edit" onclick="openEdit(${s.id})" title="Modifier">✏️</button>
        <button class="btn-icon del" onclick="deleteSession(${s.id})" title="Supprimer">🗑</button>
      </div>
    </div>
  `).join('');
}

// ═══════════════════════════════════════
// STATS
// ═══════════════════════════════════════
function updateStats() {
  const total = sessions.length;
  const minutes = sessions.reduce((a, s) => a + (s.duree || 0), 0);
  const calories = sessions.reduce((a, s) => a + (s.calories || 0), 0);

  // Streak
  const dates = [...new Set(sessions.map(s => s.date))].sort().reverse();
  let streak = 0;
  let cur = new Date(today());
  for (const d of dates) {
    const diff = Math.round((cur - new Date(d)) / 86400000);
    if (diff <= 1) { streak++; cur = new Date(d); } else break;
  }

  // Hero stats
  document.getElementById('statSeances').textContent = total;
  document.getElementById('statMinutes').textContent = minutes;
  document.getElementById('statCalories').textContent = calories;

  // Side stats
  document.getElementById('sideSeances').textContent = total;
  document.getElementById('sideMin').textContent = minutes;
  document.getElementById('sideCal').textContent = calories;
  document.getElementById('sideStreak').textContent = streak + '🔥';

  // Category progress
  const cats = { Cardio:0, Musculation:0, HIIT:0, Yoga:0, Pilates:0 };
  sessions.forEach(s => { if (cats[s.exerciseType] !== undefined) cats[s.exerciseType]++; });
  const max = Math.max(...Object.values(cats), 1);
  const catDiv = document.getElementById('categoryProgress');
  catDiv.innerHTML = Object.entries(cats).map(([cat, count]) => `
    <div class="prog-item">
      <div class="prog-label">
        <span class="prog-name">${catIcons[cat] || ''} ${cat}</span>
        <span class="prog-pct">${count}</span>
      </div>
      <div class="prog-track"><div class="prog-fill" style="width:${Math.round(count/max*100)}%"></div></div>
    </div>
  `).join('');
}

const catIcons = { Cardio:'🔴', Musculation:'💪', HIIT:'⚡', Yoga:'🌿', Pilates:'🌸' };

function saveAndRefresh() {
  localStorage.setItem('harmony_sessions', JSON.stringify(sessions));
  renderHistory();
  updateStats();
}

// ═══════════════════════════════════════
// MODALS
// ═══════════════════════════════════════
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) {
  document.getElementById(id).classList.remove('open');
  if (id === 'videoModal') { document.getElementById('videoFrame').src = ''; }
}

function openVideo(exId) {
  const ex = EXERCISES.find(e => e.id === exId);
  document.getElementById('videoTitle').textContent = '▶ ' + ex.name;
  document.getElementById('videoFrame').src = 'https://www.youtube.com/embed/' + ex.video + '?autoplay=1';
  openModal('videoModal');
}

function openQR(exId) {
  const ex = EXERCISES.find(e => e.id === exId);
  document.getElementById('qrLabel').textContent = 'Scannez pour voir la démonstration de ' + ex.name;
  openModal('qrModal');
}

function openBodyModal() { openModal('bodyModal'); }

// ═══════════════════════════════════════
// AI COACH
// ═══════════════════════════════════════
const aiResponses = [
  ...AI_RESPONSES.default,
  AI_RESPONSES.squat, AI_RESPONSES.cardio,
  AI_RESPONSES.nutrition, AI_RESPONSES.repos, AI_RESPONSES.motivation,
];

function sendAI() {
  const input = document.getElementById('aiInput');
  const msg = input.value.trim();
  if (!msg) return;

  const msgs = document.getElementById('aiMessages');
  const thinking = document.getElementById('aiThinking');

  // User bubble
  const userBubble = document.createElement('div');
  userBubble.className = 'ai-bubble user';
  userBubble.textContent = msg;
  msgs.insertBefore(userBubble, thinking);
  input.value = '';

  // Show thinking
  thinking.classList.add('show');
  msgs.scrollTop = msgs.scrollHeight;

  // Find best response
  const lower = msg.toLowerCase();
  let response;
  if (lower.includes('squat')) response = AI_RESPONSES.squat;
  else if (lower.includes('cardio') || lower.includes('courir')) response = AI_RESPONSES.cardio;
  else if (lower.includes('nutri') || lower.includes('manger') || lower.includes('protéine')) response = AI_RESPONSES.nutrition;
  else if (lower.includes('repos') || lower.includes('récup') || lower.includes('douleur')) response = AI_RESPONSES.repos;
  else if (lower.includes('motiv') || lower.includes('conseil')) response = AI_RESPONSES.motivation;
  else response = aiResponses[Math.floor(Math.random() * AI_RESPONSES.default.length)];

  setTimeout(() => {
    thinking.classList.remove('show');
    const botBubble = document.createElement('div');
    botBubble.className = 'ai-bubble bot';
    botBubble.textContent = response;
    msgs.insertBefore(botBubble, thinking);
    msgs.scrollTop = msgs.scrollHeight;
  }, 1200 + Math.random() * 800);
}

// ═══════════════════════════════════════
// UTILS
// ═══════════════════════════════════════
function formatDate(dateStr) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('fr-FR', { day:'numeric', month:'short', year:'2-digit' });
}

function showToast(type, msg) {
  const t = document.getElementById('toast');
  t.className = 'toast ' + type;
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3200);
}

function animateBodyViz() {
  const viz = document.getElementById('bodyViz');
  viz.addEventListener('click', () => {
    viz.style.transform = 'scale(1.15) rotate(-5deg)';
    setTimeout(() => viz.style.transform = '', 300);
  });
}

// Auto-calc calories on duration change
document.addEventListener('input', e => {
  if (e.target.id === 'duree' && selectedExercise) {
    const duree = parseInt(e.target.value) || 0;
    document.getElementById('calories').value = duree > 0 ? Math.round(selectedExercise.cal * duree / 60) : '';
  }
});
</script>
{% endblock %}
