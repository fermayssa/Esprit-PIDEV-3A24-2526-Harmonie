{% extends 'base.html.twig' %}

{% block title %}Activités — Harmony{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --pu:       #6A5ACD;
  --pu-dk:    #4B3B9E;
  --pu-lt:    #8B7FD4;
  --pu-pale:  #EDE8FA;
  --pu-ghost: #F7F5FD;
  --pu-deep:  #2D2060;
  --tx:       #1C1733;
  --tx-mid:   #4A4570;
  --tx-muted: #9590B8;
  --border:   rgba(106,90,205,.12);
  --white:    #FFFFFF;
  --glass:    rgba(255,255,255,.72);
  --glass-border: rgba(255,255,255,.4);
  --shadow:   0 8px 32px rgba(106,90,205,.14);
  --green:    #22C55E;
  --orange:   #F59E0B;
  --red:      #EF4444;
  --card-r:   18px;
  --font-h:   'Syne', sans-serif;
  --font-b:   'DM Sans', sans-serif;
  --font-m:   'JetBrains Mono', monospace;
}

html,body{font-family:var(--font-b);background:var(--pu-ghost);color:var(--tx);overflow-x:hidden}

/* ─── TOPBAR ─── */
.topbar{
  position:sticky;top:0;z-index:300;
  background:var(--white);
  border-bottom:1px solid var(--border);
  height:62px;display:flex;align-items:center;
  padding:0 36px;gap:6px;
}
.topbar-logo{display:flex;align-items:center;gap:10px;text-decoration:none;margin-right:28px}
.logo-mark{width:34px;height:34px;border-radius:10px;object-fit:contain;flex-shrink:0}
.nav-links{display:flex;align-items:center;gap:2px;flex:1;flex-wrap:nowrap;overflow-x:auto}
.nav-link{
  display:inline-flex;align-items:center;gap:6px;
  padding:7px 14px;border-radius:9px;
  font-size:13px;font-weight:500;
  color:var(--tx-mid);text-decoration:none;
  white-space:nowrap;transition:background .15s,color .15s;
}
.nav-link:hover{background:var(--pu-pale);color:var(--pu)}
.nav-link.active{background:var(--pu-pale);color:var(--pu);font-weight:600}
.topbar-right{display:flex;align-items:center;gap:10px;margin-left:auto;flex-shrink:0}
.logout-btn{
  padding:7px 16px;border-radius:9px;
  border:1.5px solid rgba(239,68,68,.2);
  background:transparent;color:#E05252;
  font-family:var(--font-b);font-size:13px;font-weight:500;
  cursor:pointer;transition:background .15s,border-color .15s;white-space:nowrap;
}
.logout-btn:hover{background:#FEF2F2;border-color:#E05252}
.profile-wrap{position:relative}
.avatar{
  width:36px;height:36px;border-radius:50%;
  background:var(--pu);color:white;
  font-family:var(--font-h);font-weight:700;font-size:14px;
  display:grid;place-items:center;cursor:pointer;
  border:2px solid var(--pu-pale);transition:box-shadow .15s;
}
.avatar:hover{box-shadow:0 0 0 3px rgba(106,90,205,.25)}
.profile-dropdown{
  position:absolute;top:calc(100% + 10px);right:0;
  width:220px;background:var(--white);
  border:1px solid var(--border);border-radius:14px;
  box-shadow:0 12px 40px rgba(0,0,0,.1);
  padding:16px;display:none;z-index:500;
}
.profile-dropdown.open{display:block}
.pd-name{font-size:14px;font-weight:600;color:var(--tx)}
.pd-email{font-size:12px;color:var(--tx-muted);margin-top:2px}
.pd-divider{height:1px;background:var(--border);margin:12px 0}
.pd-hint{font-size:11px;color:var(--tx-muted);font-style:italic}

/* ─── HERO BANNER ─── */
.hero-banner{
  background:linear-gradient(135deg,var(--pu-deep) 0%,var(--pu) 60%,#9B8CE8 100%);
  padding:36px 40px;
  display:flex;align-items:center;justify-content:space-between;gap:24px;
  position:relative;overflow:hidden;
}
.hero-banner::before{
  content:'';position:absolute;top:-60px;right:-60px;
  width:280px;height:280px;border-radius:50%;
  background:rgba(255,255,255,.06);pointer-events:none;
}
.hero-banner::after{
  content:'';position:absolute;bottom:-40px;left:30%;
  width:180px;height:180px;border-radius:50%;
  background:rgba(255,255,255,.04);pointer-events:none;
}
.hero-left h1{
  font-family:var(--font-h);font-size:28px;font-weight:800;
  color:white;letter-spacing:-.4px;margin-bottom:6px;
}
.hero-left p{font-size:14px;color:rgba(255,255,255,.72);font-weight:300}
.hero-stats{display:flex;gap:14px;flex-shrink:0}
.hstat{
  background:rgba(255,255,255,.12);backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.2);
  border-radius:14px;padding:14px 20px;text-align:center;min-width:90px;
}
.hstat-val{font-family:var(--font-h);font-size:22px;font-weight:800;color:white}
.hstat-lbl{font-size:10px;color:rgba(255,255,255,.65);margin-top:2px;text-transform:uppercase;letter-spacing:.5px}

/* ─── LAYOUT ─── */
.page{max-width:1280px;margin:0 auto;padding:32px 36px 80px;display:grid;grid-template-columns:1fr 360px;gap:24px;align-items:start}
.main-col{display:flex;flex-direction:column;gap:22px}
.side-col{display:flex;flex-direction:column;gap:20px;position:sticky;top:78px}

/* ─── CARDS ─── */
.card{
  background:var(--white);border:1px solid var(--border);
  border-radius:var(--card-r);overflow:hidden;
}
.card-head{
  padding:18px 22px 14px;
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
}
.card-title{
  font-family:var(--font-h);font-size:15px;font-weight:700;color:var(--tx);
  display:flex;align-items:center;gap:8px;
}
.card-body{padding:20px 22px}

/* ─── DATE + FILTER ROW ─── */
.toolbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.date-input{
  padding:9px 14px;border:1.5px solid var(--border);border-radius:10px;
  font-family:var(--font-b);font-size:13px;color:var(--tx);
  background:var(--white);cursor:pointer;outline:none;
  transition:border-color .15s;
}
.date-input:focus{border-color:var(--pu)}
.cat-filters{display:flex;gap:8px;flex-wrap:wrap;flex:1}
.cat-btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:8px 14px;border-radius:20px;border:1.5px solid var(--border);
  background:var(--white);font-family:var(--font-b);font-size:12.5px;font-weight:500;
  color:var(--tx-mid);cursor:pointer;transition:all .15s;white-space:nowrap;
}
.cat-btn:hover{border-color:var(--pu-lt);color:var(--pu);background:var(--pu-ghost)}
.cat-btn.active{background:var(--pu);border-color:var(--pu);color:white}

/* ─── EXERCISE GRID ─── */
.ex-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px}
.ex-card{
  background:var(--white);border:1.5px solid var(--border);
  border-radius:16px;overflow:hidden;cursor:pointer;
  transition:border-color .18s,transform .18s,box-shadow .18s;
  position:relative;
}
.ex-card:hover{border-color:var(--pu-lt);transform:translateY(-3px);box-shadow:var(--shadow)}
.ex-card.selected{border-color:var(--pu);box-shadow:0 0 0 3px rgba(106,90,205,.15)}
.ex-thumb{
  height:110px;background:var(--pu-ghost);
  display:flex;align-items:center;justify-content:center;
  font-size:42px;position:relative;overflow:hidden;
}
.ex-thumb-bg{
  position:absolute;inset:0;opacity:.06;
  background:radial-gradient(circle at 50% 50%,var(--pu) 0%,transparent 70%);
}
.ex-badge{
  position:absolute;top:8px;right:8px;
  font-size:10px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;
  padding:3px 8px;border-radius:20px;
}
.ex-badge.cardio{background:#FEE2E2;color:#DC2626}
.ex-badge.muscu{background:#DBEAFE;color:#1D4ED8}
.ex-badge.yoga{background:#D1FAE5;color:#065F46}
.ex-badge.hiit{background:#FEF3C7;color:#B45309}
.ex-badge.pilates{background:#EDE9FE;color:#6D28D9}
.ex-body{padding:12px 14px}
.ex-name{font-family:var(--font-h);font-size:13.5px;font-weight:700;color:var(--tx);margin-bottom:4px}
.ex-cal{font-size:11.5px;color:var(--tx-muted);display:flex;align-items:center;gap:4px}
.ex-actions{
  display:flex;gap:6px;padding:0 14px 12px;
}
.btn-xs{
  flex:1;padding:6px;border-radius:8px;border:none;
  font-family:var(--font-b);font-size:11px;font-weight:600;
  cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:4px;
}
.btn-xs.v{background:var(--pu-pale);color:var(--pu)}
.btn-xs.v:hover{background:var(--pu);color:white}
.btn-xs.q{background:#F3F4F6;color:var(--tx-mid)}
.btn-xs.q:hover{background:var(--tx-mid);color:white}

/* ─── LOG FORM ─── */
.log-form{display:flex;flex-direction:column;gap:14px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form-group{display:flex;flex-direction:column;gap:5px}
.form-group.full{grid-column:1/-1}
label{font-size:12px;font-weight:600;color:var(--tx-mid);text-transform:uppercase;letter-spacing:.4px}
input,select,textarea{
  padding:10px 14px;border:1.5px solid var(--border);border-radius:10px;
  font-family:var(--font-b);font-size:13.5px;color:var(--tx);
  background:var(--white);outline:none;transition:border-color .15s;width:100%;
}
input:focus,select:focus,textarea:focus{border-color:var(--pu)}
input.error,select.error{border-color:var(--red)}
.err-msg{font-size:11px;color:var(--red);margin-top:2px;display:none}
.err-msg.show{display:block}
textarea{resize:vertical;min-height:72px;line-height:1.5}
.btn-submit{
  width:100%;padding:13px;border-radius:11px;border:none;
  background:var(--pu);color:white;
  font-family:var(--font-h);font-size:15px;font-weight:700;
  cursor:pointer;transition:background .15s,transform .15s;
  display:flex;align-items:center;justify-content:center;gap:8px;
}
.btn-submit:hover{background:var(--pu-dk);transform:translateY(-1px)}
.btn-submit:active{transform:none}
.selected-exercise-info{
  background:var(--pu-ghost);border:1.5px solid var(--pu-pale);
  border-radius:10px;padding:12px 14px;
  display:flex;align-items:center;gap:12px;
  display:none;
}
.selected-exercise-info.show{display:flex}
.sei-icon{font-size:24px}
.sei-name{font-family:var(--font-h);font-size:14px;font-weight:700;color:var(--pu)}
.sei-type{font-size:11px;color:var(--tx-muted)}

/* ─── SESSION HISTORY ─── */
.hist-list{display:flex;flex-direction:column;gap:10px}
.hist-item{
  background:var(--white);border:1px solid var(--border);
  border-radius:14px;padding:14px 18px;
  display:flex;align-items:center;gap:14px;
  transition:border-color .15s;
}
.hist-item:hover{border-color:var(--pu-lt)}
.hist-icon{
  width:42px;height:42px;border-radius:11px;
  background:var(--pu-pale);display:grid;place-items:center;
  font-size:20px;flex-shrink:0;
}
.hist-info{flex:1;min-width:0}
.hist-name{font-family:var(--font-h);font-size:14px;font-weight:700;color:var(--tx)}
.hist-meta{display:flex;gap:12px;margin-top:4px;flex-wrap:wrap}
.hist-tag{
  font-size:11px;font-weight:500;color:var(--tx-muted);
  display:flex;align-items:center;gap:3px;
}
.hist-actions{display:flex;gap:6px;flex-shrink:0}
.btn-icon{
  width:32px;height:32px;border-radius:8px;border:1px solid var(--border);
  background:transparent;cursor:pointer;display:grid;place-items:center;
  font-size:14px;transition:all .15s;
}
.btn-icon:hover.edit{border-color:var(--pu);background:var(--pu-pale)}
.btn-icon:hover.del{border-color:var(--red);background:#FEE2E2}

/* ─── AI COACH ─── */
.ai-chat{
  background:linear-gradient(135deg,var(--pu-deep),#3D2A8A);
  border-radius:var(--card-r);overflow:hidden;
}
.ai-head{
  padding:16px 20px;display:flex;align-items:center;gap:12px;
  border-bottom:1px solid rgba(255,255,255,.12);
}
.ai-avatar{
  width:38px;height:38px;border-radius:50%;
  background:rgba(255,255,255,.15);display:grid;place-items:center;
  font-size:20px;
}
.ai-name{font-family:var(--font-h);font-size:14px;font-weight:700;color:white}
.ai-status{display:flex;align-items:center;gap:5px;font-size:11px;color:rgba(255,255,255,.6)}
.ai-dot{width:6px;height:6px;border-radius:50%;background:var(--green);animation:blink 1.8s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.ai-messages{padding:16px;height:220px;overflow-y:auto;display:flex;flex-direction:column;gap:10px}
.ai-messages::-webkit-scrollbar{width:4px}
.ai-messages::-webkit-scrollbar-thumb{background:rgba(255,255,255,.2);border-radius:4px}
.ai-bubble{
  max-width:85%;border-radius:14px;padding:10px 14px;
  font-size:12.5px;line-height:1.55;
}
.ai-bubble.bot{
  background:rgba(255,255,255,.12);color:rgba(255,255,255,.92);
  border-bottom-left-radius:4px;align-self:flex-start;
}
.ai-bubble.user{
  background:rgba(255,255,255,.22);color:white;font-weight:500;
  border-bottom-right-radius:4px;align-self:flex-end;
}
.ai-input-area{padding:12px 16px;border-top:1px solid rgba(255,255,255,.12);display:flex;gap:8px}
.ai-input{
  flex:1;padding:10px 14px;border-radius:10px;border:1px solid rgba(255,255,255,.2);
  background:rgba(255,255,255,.1);color:white;
  font-family:var(--font-b);font-size:13px;outline:none;
}
.ai-input::placeholder{color:rgba(255,255,255,.4)}
.ai-input:focus{border-color:rgba(255,255,255,.45)}
.ai-send{
  width:38px;height:38px;border-radius:10px;border:none;
  background:rgba(255,255,255,.2);color:white;cursor:pointer;
  display:grid;place-items:center;font-size:16px;transition:background .15s;
}
.ai-send:hover{background:rgba(255,255,255,.35)}
.ai-thinking{
  display:flex;gap:4px;align-items:center;padding:8px 14px;
  background:rgba(255,255,255,.12);border-radius:14px;border-bottom-left-radius:4px;
  align-self:flex-start;display:none;
}
.ai-thinking.show{display:flex}
.think-dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.6)}
.think-dot:nth-child(1){animation:bounce .8s .0s infinite}
.think-dot:nth-child(2){animation:bounce .8s .15s infinite}
.think-dot:nth-child(3){animation:bounce .8s .3s infinite}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}

/* ─── QUICK STATS SIDEBAR ─── */
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat-box{
  background:var(--pu-ghost);border:1px solid var(--border);
  border-radius:12px;padding:14px 16px;text-align:center;
}
.stat-box-val{font-family:var(--font-h);font-size:20px;font-weight:800;color:var(--pu)}
.stat-box-lbl{font-size:11px;color:var(--tx-muted);margin-top:2px}

/* ─── PROGRESS BAR ─── */
.prog-item{margin-bottom:14px}
.prog-label{display:flex;justify-content:space-between;margin-bottom:5px}
.prog-name{font-size:12.5px;font-weight:500;color:var(--tx-mid)}
.prog-pct{font-family:var(--font-m);font-size:12px;color:var(--pu);font-weight:600}
.prog-track{height:6px;background:var(--pu-ghost);border-radius:6px;overflow:hidden}
.prog-fill{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--pu-lt),var(--pu));transition:width .6s ease}

/* ─── MODALS ─── */
.modal-overlay{
  position:fixed;inset:0;background:rgba(20,15,50,.6);
  backdrop-filter:blur(6px);z-index:1000;
  display:none;align-items:center;justify-content:center;padding:20px;
}
.modal-overlay.open{display:flex}
.modal{
  background:var(--white);border-radius:22px;
  width:100%;max-width:560px;overflow:hidden;
  animation:slideUp .3s ease;
}
@keyframes slideUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
.modal-head{
  padding:20px 24px 16px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
}
.modal-title{font-family:var(--font-h);font-size:17px;font-weight:700;color:var(--tx)}
.modal-close{
  width:30px;height:30px;border-radius:8px;border:none;
  background:var(--pu-ghost);cursor:pointer;font-size:16px;
  display:grid;place-items:center;color:var(--tx-muted);
  transition:background .15s;
}
.modal-close:hover{background:var(--pu-pale);color:var(--pu)}
.modal-body{padding:24px}
.video-wrap{
  width:100%;padding-top:56.25%;border-radius:12px;
  background:var(--tx);position:relative;overflow:hidden;
}
.video-wrap iframe{position:absolute;inset:0;width:100%;height:100%;border:none}
.qr-center{display:flex;flex-direction:column;align-items:center;gap:16px;padding:16px 0}
.qr-code{width:180px;height:180px;background:var(--pu-ghost);border-radius:16px;display:grid;place-items:center}
.qr-label{font-size:13px;color:var(--tx-muted);text-align:center}

/* ─── EDIT MODAL ─── */
.edit-form{display:flex;flex-direction:column;gap:14px}
.edit-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}

/* ─── NOTIFICATIONS ─── */
.toast{
  position:fixed;bottom:28px;right:28px;z-index:2000;
  padding:13px 20px;border-radius:12px;
  font-family:var(--font-b);font-size:13.5px;font-weight:500;
  display:flex;align-items:center;gap:10px;
  transform:translateY(80px);opacity:0;
  transition:transform .3s,opacity .3s;
  max-width:340px;
}
.toast.show{transform:translateY(0);opacity:1}
.toast.success{background:#ECFDF5;color:#065F46;border:1px solid #A7F3D0}
.toast.error{background:#FEF2F2;color:#991B1B;border:1px solid #FCA5A5}
.toast.info{background:var(--pu-pale);color:var(--pu-dk);border:1px solid rgba(106,90,205,.25)}

/* ─── EMPTY STATE ─── */
.empty{
  text-align:center;padding:40px 20px;
  color:var(--tx-muted);
}
.empty-icon{font-size:40px;margin-bottom:10px;opacity:.5}
.empty-text{font-size:13.5px}

/* ─── ANIMATIONS ─── */
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.fade{animation:fadeUp .4s ease both}
.d1{animation-delay:.06s}.d2{animation-delay:.12s}.d3{animation-delay:.18s}

/* ─── RESPONSIVE ─── */
@media(max-width:1024px){
  .page{grid-template-columns:1fr;padding:24px 20px 60px}
  .side-col{position:static}
}
@media(max-width:640px){
  .topbar{padding:0 16px}
  .nav-links{display:none}
  .hero-banner{flex-direction:column;align-items:flex-start;padding:24px 20px}
  .hero-stats{flex-wrap:wrap}
  .form-row,.edit-row{grid-template-columns:1fr}
  .ex-grid{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}
}

/* ─── BODY VISUALIZER BUTTON ─── */
.body-viz-btn{
  width:100%;padding:12px;border-radius:11px;border:none;
  background:linear-gradient(135deg,#1a0533,#3d1466);
  color:white;font-family:var(--font-h);font-size:13px;font-weight:700;
  cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;
  transition:opacity .15s;letter-spacing:.3px;
}
.body-viz-btn:hover{opacity:.88}
</style>
{% endblock %}

{% block body %}
{% set current_route = app.request.attributes.get('_route') %}

<!-- ═══ TOPBAR ═══ -->
<header class="topbar">
  <a href="{{ path('homepage') }}" class="topbar-logo">
    <img src="{{ asset('images/logo.png') }}" class="logo-mark" alt="Harmony">
  </a>
  <nav class="nav-links">
    <a href="{{ path('activites') }}"  class="nav-link {{ current_route == 'activites' ? 'active' }}"><span>🏋</span> Activités</a>
    <a href="{{ path('forum') }}"      class="nav-link {{ current_route == 'forum' ? 'active' }}"><span>💬</span> Forum</a>
    <a href="{{ path('taches') }}"     class="nav-link {{ current_route == 'taches' ? 'active' }}"><span>📚</span> Tâches</a>
    <a href="{{ path('evenements') }}" class="nav-link {{ current_route == 'evenements' ? 'active' }}"><span>📅</span> Événements</a>
    <a href="{{ path('nutrition') }}"  class="nav-link {{ current_route == 'nutrition' ? 'active' }}"><span>🥗</span> Nutrition</a>
    <a href="{{ path('meditation') }}" class="nav-link {{ current_route == 'meditation' ? 'active' }}"><span>🧘</span> Méditation</a>
