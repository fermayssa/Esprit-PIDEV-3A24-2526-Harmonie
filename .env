###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=secretscret
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# IMPORTANT : serverVersion=8.2.0 est OBLIGATOIRE.
# Sans cette valeur exacte, Doctrine ne sait pas quelle plateforme MySQL
# utiliser et les INSERT échouent silencieusement (pas d'écriture en BDD).
# Votre serveur MySQL est en version 8.2.0 (vérifié dans le dump SQL).
DATABASE_URL="mysql://root:@127.0.0.1:3306/integration-pi?serverVersion=8.2.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

