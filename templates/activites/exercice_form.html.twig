{% extends 'base.html.twig' %}
{% block title %}{{ mode == 'edit' ? 'Modifier' : 'Ajouter' }} un Exercice - Harmony{% endblock %}

{% block stylesheets %}
<style>
    body { background: #f5f5f5; font-family: Arial, sans-serif; }
    .page-wrap { max-width: 600px; margin: 40px auto; padding: 0 20px; }
    h1 { color: #333; margin-bottom: 25px; }
    .card { background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.08); padding: 30px; }
    .form-group { margin-bottom: 18px; }
    label { display: block; font-weight: 600; margin-bottom: 5px; color: #444; font-size: 14px; }
    input, select, textarea {
        width: 100%; padding: 10px 12px; border: 1px solid #dee2e6; border-radius: 6px;
        font-size: 14px; outline: none; transition: border-color .2s; font-family: Arial, sans-serif;
    }
    input:focus, select:focus, textarea:focus { border-color: #dc3545; box-shadow: 0 0 0 3px rgba(220,53,69,.1); }
    input.is-invalid, select.is-invalid { border-color: #dc3545; }
    .invalid-feedback { color: #dc3545; font-size: 12px; margin-top: 4px; }
    .hint { font-size: 12px; color: #888; margin-top: 4px; }
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border-radius: 6px; border: none; cursor: pointer; font-size: 14px; font-weight: 600; text-decoration: none; }
    .btn-primary   { background: #dc3545; color: #fff; }
    .btn-secondary { background: #6c757d; color: #fff; }
    .btn:hover { opacity: .85; }
    .actions { display: flex; gap: 12px; margin-top: 24px; }
</style>
{% endblock %}

{% block body %}
<header class="topbar">
    <a href="{{ path('homepage') }}" class="topbar-logo">
        <img src="{{ asset('images/logo.png') }}" class="logo-mark" alt="Harmony">
    </a>
    <nav class="nav-links">
        <a href="{{ path('activites') }}"  class="nav-link active"><span class="nav-emoji">🏋</span> Activités</a>
        <a href="{{ path('forum') }}"      class="nav-link"><span class="nav-emoji">💬</span> Forum</a>
        <a href="{{ path('taches') }}"     class="nav-link"><span class="nav-emoji">📚</span> Tâches</a>
        <a href="{{ path('evenements') }}" class="nav-link"><span class="nav-emoji">📅</span> Événements</a>
        <a href="{{ path('nutrition') }}"  class="nav-link"><span class="nav-emoji">🥗</span> Nutrition</a>
        <a href="{{ path('meditation') }}" class="nav-link"><span class="nav-emoji">🧘</span> Méditation</a>
        <a href="{{ path('journal') }}"    class="nav-link"><span class="nav-emoji">📔</span> Journal</a>
        <a href="{{ path('library') }}"    class="nav-link"><span class="nav-emoji">📖</span> Library</a>
    </nav>
    <div class="topbar-right">
        <button class="logout-btn">🚪 Déconnexion</button>
        <div class="profile-wrap"><div class="avatar">E</div></div>
    </div>
</header>

<div class="page-wrap">
    <h1>{{ mode == 'edit' ? '✏️ Modifier l\'exercice' : '💪 Nouvel Exercice' }}</h1>

    <div class="card">
        <form method="post" novalidate>

            <div class="form-group">
                <label for="nomExercice">Nom de l'exercice *</label>
                <input type="text" id="nomExercice" name="nomExercice"
                       value="{{ exercice.nomExercice }}"
                       class="{{ errors.nomExercice is defined ? 'is-invalid' : '' }}"
                       placeholder="Ex: Pompes, Course à pied, Squat..."
                       maxlength="255" required>
                {% if errors.nomExercice is defined %}
                    <div class="invalid-feedback">{{ errors.nomExercice }}</div>
                {% endif %}
            </div>

            <div class="form-group">
                <label for="typeExercice">Type d'exercice *</label>
                <select id="typeExercice" name="typeExercice"
                        class="{{ errors.typeExercice is defined ? 'is-invalid' : '' }}" required>
                    <option value="">-- Choisir un type --</option>
                    <option value="Cardio"      {{ exercice.typeExercice == 'Cardio'      ? 'selected' }}>🏃 Cardio</option>
                    <option value="Musculation" {{ exercice.typeExercice == 'Musculation' ? 'selected' }}>💪 Musculation</option>
                    <option value="Yoga"        {{ exercice.typeExercice == 'Yoga'        ? 'selected' }}>🧘 Yoga</option>
                    <option value="Sport"       {{ exercice.typeExercice == 'Sport'       ? 'selected' }}>⚽ Sport</option>
                    <option value="Autre"       {{ exercice.typeExercice == 'Autre'       ? 'selected' }}>📌 Autre</option>
                </select>
                {% if errors.typeExercice is defined %}
                    <div class="invalid-feedback">{{ errors.typeExercice }}</div>
                {% endif %}
            </div>

            <div class="form-group">
                <label for="videoExercice">URL Vidéo de démonstration (facultatif)</label>
                <input type="url" id="videoExercice" name="videoExercice"
                       value="{{ exercice.videoExercice }}"
                       class="{{ errors.videoExercice is defined ? 'is-invalid' : '' }}"
                       placeholder="https://youtube.com/...">
                <div class="hint">Lien vers une vidéo YouTube ou autre plateforme</div>
                {% if errors.videoExercice is defined %}
                    <div class="invalid-feedback">{{ errors.videoExercice }}</div>
                {% endif %}
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary">
                    {{ mode == 'edit' ? '💾 Sauvegarder' : '✅ Créer l\'exercice' }}
                </button>
                <a href="{{ path('activites') }}" class="btn btn-secondary">❌ Annuler</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
