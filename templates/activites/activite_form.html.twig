{% extends 'base.html.twig' %}
{% block title %}{{ mode == 'edit' ? 'Modifier' : 'Ajouter' }} une Séance - Harmony{% endblock %}

{% block stylesheets %}
<style>
    body { background: #f5f5f5; font-family: Arial, sans-serif; }
    .page-wrap { max-width: 620px; margin: 40px auto; padding: 0 20px; }
    h1 { color: #333; margin-bottom: 25px; }
    .card { background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.08); padding: 30px; }
    .form-group { margin-bottom: 18px; }
    label { display: block; font-weight: 600; margin-bottom: 5px; color: #444; font-size: 14px; }
    input, select, textarea {
        width: 100%; padding: 10px 12px; border: 1px solid #dee2e6; border-radius: 6px;
        font-size: 14px; outline: none; transition: border-color .2s; font-family: Arial, sans-serif;
    }
    input:focus, select:focus { border-color: #dc3545; box-shadow: 0 0 0 3px rgba(220,53,69,.1); }
    input.is-invalid, select.is-invalid { border-color: #dc3545; }
    .invalid-feedback { color: #dc3545; font-size: 12px; margin-top: 4px; }
    .hint { font-size: 12px; color: #888; margin-top: 4px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border-radius: 6px; border: none; cursor: pointer; font-size: 14px; font-weight: 600; text-decoration: none; }
    .btn-primary   { background: #dc3545; color: #fff; }
    .btn-secondary { background: #6c757d; color: #fff; }
    .btn:hover { opacity: .85; }
    .actions { display: flex; gap: 12px; margin-top: 24px; }
    .section-label {
        font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
        color: #888; margin: 20px 0 12px; padding-bottom: 6px; border-bottom: 1px dashed #ddd;
    }
    .alert { padding: 10px 14px; border-radius: 6px; margin-bottom: 16px; }
    .alert-info { background: #e8f4f8; border: 1px solid #bee5eb; color: #0c5460; }
</style>
{% endblock %}

{% block body %}
<header class="topbar">
    <a href="{{ path('homepage') }}" class="topbar-logo">
        <img src="{{ asset('images/logo.png') }}" class="logo-mark" alt="Harmony">
    </a>
    <nav class="nav-links">
        <a href="{{ path('activites') }}"  class="nav-link active"><span class="nav-emoji">🏋</span> Activités</a>
        <a href="{{ path('forum') }}"      class="nav-link"><span class="nav-emoji">💬</span> Forum</a>
        <a href="{{ path('taches') }}"     class="nav-link"><span class="nav-emoji">📚</span> Tâches</a>
        <a href="{{ path('evenements') }}" class="nav-link"><span class="nav-emoji">📅</span> Événements</a>
        <a href="{{ path('nutrition') }}"  class="nav-link"><span class="nav-emoji">🥗</span> Nutrition</a>
        <a href="{{ path('meditation') }}" class="nav-link"><span class="nav-emoji">🧘</span> Méditation</a>
        <a href="{{ path('journal') }}"    class="nav-link"><span class="nav-emoji">📔</span> Journal</a>
        <a href="{{ path('library') }}"    class="nav-link"><span class="nav-emoji">📖</span> Library</a>
    </nav>
    <div class="topbar-right">
        <button class="logout-btn">🚪 Déconnexion</button>
        <div class="profile-wrap"><div class="avatar">E</div></div>
    </div>
</header>

<div class="page-wrap">
    <h1>{{ mode == 'edit' ? '✏️ Modifier la séance' : '🏃 Nouvelle Séance' }}</h1>

    {% if exercices|length == 0 %}
        <div class="alert alert-info">
            ℹ️ Aucun exercice disponible.
            <a href="{{ path('exercice_new') }}" style="color:#0c5460;font-weight:bold;">Créer d'abord un exercice</a>
        </div>
    {% endif %}

    <div class="card">
        <form method="post" novalidate>

            <div class="section-label">Informations obligatoires</div>

            <div class="form-group">
                <label for="exerciceId">Exercice *</label>
                <select id="exerciceId" name="exerciceId"
                        class="{{ errors.exercice is defined ? 'is-invalid' : '' }}" required>
                    <option value="">-- Choisir un exercice --</option>
                    {% for e in exercices %}
                        <option value="{{ e.id }}"
                                {{ activite.exercice and activite.exercice.id == e.id ? 'selected' }}>
                            {{ e.nomExercice }} ({{ e.typeExercice }})
                        </option>
                    {% endfor %}
                </select>
                {% if errors.exercice is defined %}
                    <div class="invalid-feedback">{{ errors.exercice }}</div>
                {% endif %}
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="dureeMinutes">Durée (minutes) *</label>
                    <input type="number" id="dureeMinutes" name="dureeMinutes"
                           value="{{ activite.dureeMinutes }}"
                           class="{{ errors.dureeMinutes is defined ? 'is-invalid' : '' }}"
                           placeholder="Ex: 30" min="1" max="600" required>
                    {% if errors.dureeMinutes is defined %}
                        <div class="invalid-feedback">{{ errors.dureeMinutes }}</div>
                    {% endif %}
                </div>
                <div class="form-group">
                    <label for="caloriesBrulees">Calories brûlées *</label>
                    <input type="number" id="caloriesBrulees" name="caloriesBrulees"
                           value="{{ activite.caloriesBrulees }}"
                           class="{{ errors.caloriesBrulees is defined ? 'is-invalid' : '' }}"
                           placeholder="Ex: 250" min="0" max="5000" required>
                    {% if errors.caloriesBrulees is defined %}
                        <div class="invalid-feedback">{{ errors.caloriesBrulees }}</div>
                    {% endif %}
                </div>
            </div>

            <div class="form-group">
                <label for="dateActivite">Date de la séance *</label>
                <input type="date" id="dateActivite" name="dateActivite"
                       value="{{ activite.dateActivite ? activite.dateActivite|date('Y-m-d') : 'now'|date('Y-m-d') }}"
                       required>
            </div>

            <div class="section-label">Informations facultatives</div>

            <div class="form-row">
                <div class="form-group">
                    <label for="nbSeries">Nombre de séries</label>
                    <input type="number" id="nbSeries" name="nbSeries"
                           value="{{ activite.nbSeries }}"
                           class="{{ errors.nbSeries is defined ? 'is-invalid' : '' }}"
                           placeholder="Ex: 3" min="0" max="50">
                    {% if errors.nbSeries is defined %}
                        <div class="invalid-feedback">{{ errors.nbSeries }}</div>
                    {% endif %}
                </div>
                <div class="form-group">
                    <label for="nbRepetitions">Répétitions par série</label>
                    <input type="number" id="nbRepetitions" name="nbRepetitions"
                           value="{{ activite.nbRepetitions }}"
                           class="{{ errors.nbRepetitions is defined ? 'is-invalid' : '' }}"
                           placeholder="Ex: 12" min="0" max="200">
                    {% if errors.nbRepetitions is defined %}
                        <div class="invalid-feedback">{{ errors.nbRepetitions }}</div>
                    {% endif %}
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="poids">Poids utilisé (kg)</label>
                    <input type="number" id="poids" name="poids"
                           value="{{ activite.poids }}"
                           class="{{ errors.poids is defined ? 'is-invalid' : '' }}"
                           placeholder="Ex: 20" min="0" max="500" step="0.5">
                    {% if errors.poids is defined %}
                        <div class="invalid-feedback">{{ errors.poids }}</div>
                    {% endif %}
                </div>
            </div>

            <div class="form-group">
                <label for="notes">Notes sur la séance</label>
                <textarea id="notes" name="notes" rows="3"
                          placeholder="Commentaires, ressenti, objectifs...">{{ activite.notes }}</textarea>
                <div class="hint">Maximum 500 caractères</div>
                {% if errors.notes is defined %}
                    <div class="invalid-feedback">{{ errors.notes }}</div>
                {% endif %}
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary">
                    {{ mode == 'edit' ? '💾 Sauvegarder' : '✅ Enregistrer la séance' }}
                </button>
                <a href="{{ path('activites') }}" class="btn btn-secondary">❌ Annuler</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
