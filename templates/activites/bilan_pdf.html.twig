<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bilan d'Activités — Harmony</title>
<style>
/* ══════════════════════════════════════════════════
   HARMONY — BILAN PDF TEMPLATE
   Utilisé par KnpSnappyBundle (wkhtmltopdf)
   Police : Arial/sans-serif (dispo wkhtmltopdf)
   Couleur principale : #6a1b9a (violet Harmony)
══════════════════════════════════════════════════ */
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    color: #1C1733;
    background: #fff;
}

/* ── PAGE WRAPPER ── */
.page {
    width: 210mm;
    min-height: 297mm;
    position: relative;
    background: #ffffff;
}

/* ─── HEADER ─── */
.header {
    background: linear-gradient(135deg, #1A1035 0%, #4B3B9E 60%, #6a1b9a 100%);
    padding: 0;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    position: relative;
    overflow: hidden;
}
.header::before {
    content: '';
    position: absolute;
    top: -30px; left: -30px;
    width: 140px; height: 140px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
}
.header::after {
    content: '';
    position: absolute;
    bottom: -40px; right: 60px;
    width: 100px; height: 100px;
    border-radius: 50%;
    background: rgba(255,255,255,0.05);
}
.header-left {
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 1;
}
.logo-circle {
    width: 40px; height: 40px;
    border-radius: 12px;
    background: rgba(255,255,255,0.18);
    border: 1.5px solid rgba(255,255,255,0.3);
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
}
.header-title {
    font-size: 20px;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.5px;
    line-height: 1.1;
}
.header-sub {
    font-size: 10px;
    color: rgba(255,255,255,0.65);
    margin-top: 2px;
    font-weight: 400;
}
.header-right {
    z-index: 1;
    text-align: right;
}
.header-date {
    font-size: 10px;
    color: rgba(255,255,255,0.75);
    font-weight: 400;
}
.header-badge {
    display: inline-block;
    margin-top: 4px;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 30px;
    padding: 2px 10px;
    font-size: 9px;
    font-weight: 700;
    color: #c3b1ff;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

/* ─── STATS STRIP ─── */
.stats-strip {
    background: linear-gradient(90deg, #EDE8FA, #F7F5FD, #EDE8FA);
    border-bottom: 2px solid rgba(106,27,154,0.12);
    padding: 14px 24px;
    display: flex;
    justify-content: space-around;
    align-items: center;
}
.stat-item {
    text-align: center;
}
.stat-val {
    font-size: 26px;
    font-weight: 900;
    color: #6a1b9a;
    line-height: 1;
}
.stat-lbl {
    font-size: 9.5px;
    color: #9590B8;
    margin-top: 3px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 700;
}
.stat-sep {
    width: 1px;
    height: 40px;
    background: rgba(106,27,154,0.15);
}

/* ─── SECTION TITLE ─── */
.section-title {
    font-size: 13px;
    font-weight: 900;
    color: #1C1733;
    padding: 16px 24px 6px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.section-title::after {
    content: '';
    flex: 1;
    height: 1.5px;
    background: linear-gradient(90deg, rgba(106,27,154,0.3), transparent);
    margin-left: 8px;
}

/* ─── CONTENT AREA ─── */
.content {
    padding: 0 24px 100px;
}

/* ─── SESSION BLOCK ─── */
.session-block {
    margin-bottom: 14px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(106,27,154,0.12);
    page-break-inside: avoid;
}
.session-head {
    background: linear-gradient(90deg, #F0EAFE, #F7F5FD);
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(106,27,154,0.08);
}
.session-date {
    font-size: 12px;
    font-weight: 800;
    color: #4B3B9E;
}
.session-tags {
    display: flex;
    gap: 6px;
    align-items: center;
}
.stag {
    font-size: 9px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 20px;
}
.stag.ex  { background: #EDE8FA; color: #6a1b9a; }
.stag.min { background: #E8F8F1; color: #0B7A4C; }
.stag.cal { background: #FFF3E0; color: #B45309; }

/* ─── EXERCISE ROWS ─── */
.ex-table {
    width: 100%;
    border-collapse: collapse;
}
.ex-row {
    border-bottom: 1px solid rgba(106,27,154,0.05);
}
.ex-row:last-child { border-bottom: none; }
.ex-row td {
    padding: 8px 16px;
    vertical-align: top;
    font-size: 10.5px;
}
.ex-name {
    font-weight: 700;
    color: #1C1733;
    width: 38%;
}
.ex-type-badge {
    display: inline-block;
    font-size: 8.5px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 10px;
    margin-left: 4px;
    vertical-align: middle;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}
.cardio  { background: #FF6B6B; color: white; }
.force   { background: #5B8DEF; color: white; }
.souplesse { background: #43D39E; color: white; }
.endurance { background: #F7B731; color: white; }
.perte   { background: #FD7272; color: white; }
.default { background: #9590B8; color: white; }

.ex-meta {
    color: #6A5ACD;
    width: 44%;
    font-size: 10px;
}
.ex-meta span {
    display: inline-block;
    margin-right: 8px;
}
.ex-notes {
    color: #9590B8;
    font-style: italic;
    width: 18%;
    font-size: 9.5px;
}

/* ─── EMPTY STATE ─── */
.empty-state {
    text-align: center;
    padding: 40px 20px;
    color: #9590B8;
    font-style: italic;
    font-size: 12px;
}

/* ─── CERTIFIÉ STAMP ─── */
.stamp-wrap {
    text-align: center;
    padding: 20px 24px 0;
}
.stamp {
    display: inline-block;
    border: 3px solid #6a1b9a;
    border-radius: 50%;
    width: 110px;
    height: 110px;
    line-height: 1.2;
    text-align: center;
    padding: 16px 8px;
    transform: rotate(-8deg);
    opacity: 0.75;
    color: #6a1b9a;
    position: relative;
}
.stamp-top {
    font-size: 8px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    display: block;
}
.stamp-main {
    font-size: 10px;
    font-weight: 900;
    color: #4B3B9E;
    display: block;
    margin: 4px 0;
}
.stamp-emoji { font-size: 18px; display: block; }
.stamp-bottom {
    font-size: 7px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    display: block;
    margin-top: 3px;
}

/* ─── FOOTER ─── */
.footer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 36px;
    background: linear-gradient(135deg, #1A1035, #4B3B9E);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
}
.footer-left {
    font-size: 8px;
    color: rgba(255,255,255,0.65);
    letter-spacing: 0.3px;
}
.footer-center {
    font-size: 9px;
    font-weight: 700;
    color: rgba(195, 177, 255, 0.85);
    letter-spacing: 0.5px;
}
.footer-right {
    font-size: 8px;
    color: rgba(255,255,255,0.5);
}
</style>
</head>
<body>
<div class="page">

  {# ── HEADER ── #}
  <div class="header">
    <div class="header-left">
      <div class="logo-circle">🏋️</div>
      <div>
        <div class="header-title">Harmony</div>
        <div class="header-sub">Bilan d'Activités Sportives</div>
      </div>
    </div>
    <div class="header-right">
      <div class="header-date">
        Exporté le {{ exportDate|date('d/m/Y') }} à {{ exportDate|date('H:i') }}
      </div>
      <span class="header-badge">✦ Document officiel</span>
    </div>
  </div>

  {# ── STATS STRIP ── #}
  <div class="stats-strip">
    <div class="stat-item">
      <div class="stat-val">{{ stats.sessions }}</div>
      <div class="stat-lbl">🏆 Séances</div>
    </div>
    <div class="stat-sep"></div>
    <div class="stat-item">
      <div class="stat-val">{{ stats.minutes }}</div>
      <div class="stat-lbl">⏱ Minutes</div>
    </div>
    <div class="stat-sep"></div>
    <div class="stat-item">
      <div class="stat-val">{{ stats.calories }}</div>
      <div class="stat-lbl">🔥 Calories</div>
    </div>
    <div class="stat-sep"></div>
    <div class="stat-item">
      <div class="stat-val">
        {% set totalEx = 0 %}
        {% for date, exs in grouped %}{% set totalEx = totalEx + exs|length %}{% endfor %}
        {{ totalEx }}
      </div>
      <div class="stat-lbl">💪 Exercices</div>
    </div>
  </div>

  {# ── SECTION TITLE ── #}
  <div class="section-title">📊 Historique des Séances</div>

  {# ── SESSIONS ── #}
  <div class="content">
    {% if grouped is empty %}
      <div class="empty-state">Aucune séance enregistrée.</div>
    {% else %}
      {% for date, exercises in grouped %}
        {% set totalMin = 0 %}
        {% set totalCal = 0 %}
        {% for ex in exercises %}
          {% set totalMin = totalMin + ex.duree_minutes %}
          {% set totalCal = totalCal + (ex.calories_brulees ?: 0) %}
        {% endfor %}

        <div class="session-block">
          <div class="session-head">
            <div class="session-date">
              📅 {{ date|date('d/m/Y') }}
            </div>
            <div class="session-tags">
              <span class="stag ex">{{ exercises|length }} ex.</span>
              <span class="stag min">⏱ {{ totalMin }} min</span>
              {% if totalCal > 0 %}<span class="stag cal">🔥 {{ totalCal }} kcal</span>{% endif %}
            </div>
          </div>

          <table class="ex-table">
            {% for ex in exercises %}
              {% set typeLow = (ex.exercice_type ?: '')|lower %}
              {% set cls = 'default' %}
              {% if 'cardio' in typeLow %}{% set cls = 'cardio' %}
              {% elseif 'force' in typeLow %}{% set cls = 'force' %}
              {% elseif 'souplesse' in typeLow %}{% set cls = 'souplesse' %}
              {% elseif 'endurance' in typeLow %}{% set cls = 'endurance' %}
              {% elseif 'perte' in typeLow %}{% set cls = 'perte' %}
              {% endif %}
              <tr class="ex-row">
                <td class="ex-name">
                  {{ ex.exercice_nom ?: 'Exercice' }}
                  {% if ex.exercice_type %}
                    <span class="ex-type-badge {{ cls }}">{{ ex.exercice_type|replace({'_':' '})|split(' ')|first }}</span>
                  {% endif %}
                </td>
                <td class="ex-meta">
                  <span>⏱ {{ ex.duree_minutes }} min</span>
                  {% if ex.calories_brulees %}<span>🔥 {{ ex.calories_brulees }} kcal</span>{% endif %}
                  {% if ex.nb_series %}<span>🔁 {{ ex.nb_series }}×{{ ex.nb_repetitions ?: '?' }}</span>{% endif %}
                  {% if ex.poids %}<span>⚖ {{ ex.poids }} kg</span>{% endif %}
                </td>
                <td class="ex-notes">
                  {% if ex.notes %}"{{ ex.notes }}"{% endif %}
                </td>
              </tr>
            {% endfor %}
          </table>
        </div>
      {% endfor %}
    {% endif %}

    {# ── TAMPON CERTIFIÉ PAR HARMONY ── #}
    <div class="stamp-wrap">
      <div class="stamp">
        <span class="stamp-top">Certifié par</span>
        <span class="stamp-emoji">💜</span>
        <span class="stamp-main">HARMONY</span>
        <span class="stamp-bottom">App · {{ exportDate|date('Y') }}</span>
      </div>
    </div>
  </div>

  {# ── FOOTER FIXE ── #}
  <div class="footer">
    <span class="footer-left">Harmony — Journal de Sport | Confidentiel</span>
    <span class="footer-center">💜 harmony-app.fr</span>
    <span class="footer-right">{{ exportDate|date('d/m/Y') }}</span>
  </div>

</div>
</body>
</html>
