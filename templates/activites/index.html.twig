// AI COACH
// ══════════════════════════════════════════════════════
const AI_TIPS = [
  "Pour progresser, augmentez la charge ou les répétitions chaque semaine ! 💪",
  "La récupération est essentielle : dormez 7-9h et reposez-vous 48h entre séances.",
  "Hydratez-vous ! 500ml avant l'entraînement, 150ml toutes les 15-20 minutes pendant. 💧",
  "Le HIIT brûle jusqu'à 30% de calories de plus que le cardio classique. ⚡",
  "Mangez des protéines dans les 30 minutes après l'effort pour optimiser la récupération. 🥩",
  "La constance bat l'intensité : 5 séances modérées > 1 intense par semaine. 🎯",
  "Faites des étirements dynamiques avant et statiques après l'entraînement. 🧘",
];

function sendAI() {
  const input = document.getElementById('aiInput');
  const msg = input.value.trim();
  if (!msg) return;
  const msgs = document.getElementById('aiMessages');
  const thinking = document.getElementById('aiThinking');
  const userBubble = document.createElement('div');
  userBubble.className = 'ai-bubble user';
  userBubble.textContent = msg;
  msgs.insertBefore(userBubble, thinking);
  input.value = '';
  thinking.classList.add('show');
  msgs.scrollTop = msgs.scrollHeight;
  const lower = msg.toLowerCase();
  let response = AI_TIPS[Math.floor(Math.random() * AI_TIPS.length)];
  if (lower.includes('squat'))   response = "Squat : dos droit, genoux dans l'axe des pieds, descendez à 90°. Maîtrisez la technique avant d'augmenter le poids ! 🦵";
  else if (lower.includes('cardio')) response = "Alternez HIIT et Zone 2 : le Zone 2 améliore l'endurance, le HIIT booste le métabolisme. ❤️";
  else if (lower.includes('nutri') || lower.includes('manger')) response = "Glucides complexes 1-2h avant, protéines + glucides dans les 30 min après l'effort. 🥗";
  else if (lower.includes('repos') || lower.includes('récup')) response = "Repos actif les jours off : marche légère, yoga ou stretching. Évitez l'inactivité totale. 😴";
  setTimeout(() => {
    thinking.classList.remove('show');
    const botBubble = document.createElement('div');
    botBubble.className = 'ai-bubble bot';
    botBubble.textContent = response;
    msgs.insertBefore(botBubble, thinking);
    msgs.scrollTop = msgs.scrollHeight;
  }, 1000 + Math.random() * 600);
}

