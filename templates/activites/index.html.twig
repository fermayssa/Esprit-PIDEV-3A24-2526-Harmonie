const FAV_KEY = 'harmony_favs';
function loadFavs() { try { return JSON.parse(localStorage.getItem(FAV_KEY)) || {}; } catch { return {}; } }
function saveFavs(favs) { localStorage.setItem(FAV_KEY, JSON.stringify(favs)); }

function toggleFav(btn) {
  const { id, name, type, icon } = btn.dataset;
  const favs = loadFavs();
  if (favs[id]) {
    delete favs[id];
    btn.classList.remove('active');
    btn.innerHTML = '⭐ Fav';
    showToast('info', '⭐ Retiré des favoris');
  } else {
    favs[id] = { id, name, type, icon };
    btn.classList.add('active');
    btn.innerHTML = '★ Favori';
    showToast('success', '⭐ ' + name + ' ajouté aux favoris !');
  }
  saveFavs(favs);
  renderFavList(favs);
}

function removeFav(id) {
  const favs = loadFavs();
  delete favs[id];
  saveFavs(favs);
  const btn = document.querySelector(`.fav-btn[data-id="${id}"]`);
  if (btn) { btn.classList.remove('active'); btn.innerHTML = '⭐ Fav'; }
  renderFavList(favs);
}

function renderFavList(favs) {
  const list  = document.getElementById('favList');
  const empty = document.getElementById('favEmpty');
  const count = document.getElementById('favCount');
  const keys  = Object.keys(favs);
  count.textContent = keys.length === 0 ? '0 fav' : keys.length + ' favori' + (keys.length > 1 ? 's' : '');
  if (keys.length === 0) {
    list.innerHTML = '';
    list.appendChild(empty);
    empty.style.display = '';
    return;
  }
  list.innerHTML = '';
  keys.forEach(id => {
    const f = favs[id];
    const typeLow = (f.type || '').toLowerCase();
    let tcls = 'force';
    if (typeLow.includes('cardio'))     tcls = 'cardio';
    else if (typeLow.includes('souplesse')) tcls = 'souplesse';
    else if (typeLow.includes('endurance')) tcls = 'endurance';
    else if (typeLow.includes('perte'))     tcls = 'perte';
    const item = document.createElement('div');
    item.className = 'fav-item';
    item.innerHTML = `
      <div class="fav-emoji">${f.icon}</div>
      <div class="fav-info">
        <div class="fav-name" title="${f.name}">${f.name}</div>
        <span class="fav-type-badge ${tcls}">${(f.type||'').replace(/_/g,' ').split(' ')[0]}</span>
      </div>
      <button class="fav-remove" title="Retirer des favoris" onclick="removeFav('${id}')">✕</button>`;
    list.appendChild(item);
  });
}

function initFavs() {
  const favs = loadFavs();
  document.querySelectorAll('.fav-btn').forEach(btn => {
    if (favs[btn.dataset.id]) { btn.classList.add('active'); btn.innerHTML = '★ Favori'; }
  });
  renderFavList(favs);
}

// ══════════════════════════════════════════════════════
// QR CODE — Bundle 1 : endroid/qr-code-bundle
// Appelle GET /activites/qr/{date} → JSON avec dataUri PNG
// ══════════════════════════════════════════════════════
async function openQR(date) {
  // Ouvre la modale et affiche le spinner
  const wrap   = document.getElementById('qrImgWrap');
  const waLink = document.getElementById('qrWaLink');
  document.getElementById('qrDate').textContent = '—';
  document.getElementById('qrMeta').textContent = '—';
  wrap.innerHTML = '<span class="qr-loading">⏳</span>';
  waLink.href = '#';
  openModal('qrModal');

  try {
    const res  = await fetch(API.qr(date));
    const data = await res.json();

    if (!data.success) {
      wrap.innerHTML = '<div style="color:#EF4444;font-size:13px;text-align:center;padding:20px">⚠ Séance introuvable</div>';
      return;
    }

    // Affiche le QR code (Data URI PNG généré par QrCodeService)
    wrap.innerHTML = `<img src="${data.qr}" alt="QR Code séance ${data.dateLabel}" style="width:100%;height:100%;object-fit:contain">`;

    // Met à jour les métadonnées de la modale
    document.getElementById('qrDate').textContent = '📅 ' + data.dateLabel;
    document.getElementById('qrMeta').textContent =
      data.nbEx + ' exercice' + (data.nbEx !== 1 ? 's' : '') +
      ' · ' + data.totalMin + ' min' +
      (data.totalCal > 0 ? ' · ' + data.totalCal + ' kcal' : '');

    // Lien WhatsApp direct (clic sur le bouton vert)
    waLink.href = data.waUrl;

    showToast('success', '📲 QR Code généré pour la séance du ' + data.dateLabel);
  } catch (err) {
    wrap.innerHTML = '<div style="color:#EF4444;font-size:13px;text-align:center;padding:20px">⚠ Erreur réseau</div>';
    showToast('error', '⚠ Impossible de générer le QR code.');
  }
}

// ══════════════════════════════════════════════════════
function exportPDF() {
  const btn = document.getElementById('exportPdfBtn');
  btn.textContent = '⏳ Génération en cours...';
  btn.disabled = true;

  // Fetch latest data from API
  fetch(API.list)
    .then(r => r.json())
    .then(data => {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ orientation:'portrait', unit:'mm', format:'a4' });
      const W = 210; const M = 18;

      // Header gradient simulation
      doc.setFillColor(42, 31, 105);
      doc.rect(0, 0, W, 38, 'F');

      doc.setTextColor(255,255,255);
      doc.setFont('helvetica','bold');
      doc.setFontSize(20);
      doc.text('Bilan d\'Activités — Harmony', M, 18);
      doc.setFontSize(9);
      doc.setFont('helvetica','normal');
      const now = new Date();
      doc.text('Exporté le ' + now.toLocaleDateString('fr-FR',{weekday:'long',year:'numeric',month:'long',day:'numeric'}), M, 28);

      // Stats strip
      doc.setFillColor(237, 232, 250);
      doc.roundedRect(M, 44, W-M*2, 26, 4, 4, 'F');
      const stats = data.stats || {};
      doc.setTextColor(75, 59, 158);
      doc.setFont('helvetica','bold');
      doc.setFontSize(11);
      const sw = (W-M*2)/3;
      [['🏆 Séances', stats.sessions||0],['⏱ Minutes', stats.minutes||0],['🔥 Calories', stats.calories||0]].forEach(([lbl,val],i)=>{
        const x = M + sw*i + sw/2;
        doc.text(String(val), x, 55, {align:'center'});
        doc.setFontSize(8); doc.setFont('helvetica','normal');
        doc.setTextColor(107,90,205);
        doc.text(lbl, x, 62, {align:'center'});
        doc.setFontSize(11); doc.setFont('helvetica','bold'); doc.setTextColor(75,59,158);
      });

      // Sessions
      let y = 78;
      doc.setTextColor(28, 23, 51);
      doc.setFont('helvetica','bold'); doc.setFontSize(13);
      doc.text('Historique des Séances', M, y); y += 8;
      doc.setDrawColor(106,90,205); doc.setLineWidth(.4);
      doc.line(M, y, W-M, y); y += 7;

      (data.sessions || []).forEach(session => {
        if (y > 265) { doc.addPage(); y = 20; }
        // Session header
        doc.setFillColor(247,245,253);
        doc.roundedRect(M, y-4, W-M*2, 10, 2, 2, 'F');
        doc.setFont('helvetica','bold'); doc.setFontSize(11);
        doc.setTextColor(106,90,205);
        doc.text('📅 ' + formatDate(session.date), M+3, y+3);
        const exCount = session.exercises.length;
        const totalMin = session.exercises.reduce((a,e)=>a+(e.duree_minutes||0),0);
        doc.setFont('helvetica','normal'); doc.setFontSize(8); doc.setTextColor(149,144,184);
        doc.text(exCount + ' exercice' + (exCount!==1?'s':'') + '  ·  ' + totalMin + ' min', W-M-3, y+3, {align:'right'});
        y += 10;

        session.exercises.forEach(ex => {
          if (y > 270) { doc.addPage(); y = 20; }
          doc.setFont('helvetica','normal'); doc.setFontSize(9.5); doc.setTextColor(28,23,51);
          doc.text('• ' + (ex.exercice_nom || 'Exercice'), M+4, y);
          const meta = [];
          if (ex.duree_minutes) meta.push(ex.duree_minutes + ' min');
          if (ex.calories_brulees) meta.push(ex.calories_brulees + ' kcal');
          if (ex.nb_series) meta.push(ex.nb_series + '×' + (ex.nb_repetitions||'?'));
          if (ex.poids) meta.push(ex.poids + ' kg');
          if (meta.length) {
            doc.setFontSize(8); doc.setTextColor(149,144,184);
            doc.text(meta.join('  ·  '), M+4, y+4);
            y += 4;
          }
          y += 7;
        });
        y += 3;
      });

      if ((data.sessions||[]).length === 0) {
        doc.setFont('helvetica','italic'); doc.setFontSize(10); doc.setTextColor(149,144,184);
        doc.text('Aucune séance enregistrée.', M, y);
      }

      // Footer
      doc.setFillColor(42, 31, 105);
      doc.rect(0, 287, W, 10, 'F');
      doc.setFont('helvetica','normal'); doc.setFontSize(7); doc.setTextColor(200,190,255);
      doc.text('Harmony — Journal de Sport  |  harmony-app.fr', W/2, 293, {align:'center'});

      doc.save('bilan-activites-' + new Date().toISOString().split('T')[0] + '.pdf');
      showToast('success', '✅ Bilan PDF exporté !');
    })
    .catch(() => { showToast('error', '⚠ Erreur lors de l\'export PDF.'); })
    .finally(() => { btn.textContent = '📄 Exporter le bilan PDF'; btn.disabled = false; });
}

// ══════════════════════════════════════════════════════
// UTILS
// ══════════════════════════════════════════════════════
function formatDate(dateStr) {
  if (!dateStr) return '';
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric' });
}

function showToast(type, msg) {
  const t = document.getElementById('toast');
  t.className = 'toast ' + type;
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._timeout);
  t._timeout = setTimeout(() => t.classList.remove('show'), 3500);
}
</script>
