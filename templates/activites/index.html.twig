{% extends 'base.html.twig' %}

{% block title %}Activités — Harmony{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=DM+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-o9N1j7kG8bChx9cArCdZUrw2s2tRoSI6eR7X9tUuCPk=" crossorigin="" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --pu:#6A5ACD;--pu-dk:#4B3B9E;--pu-lt:#8B7FD4;--pu-pale:#EDE8FA;
  --pu-ghost:#F7F5FD;--pu-deep:#1A1035;
  --tx:#1C1733;--tx-mid:#4A4570;--tx-muted:#9590B8;
  --border:rgba(106,90,205,.12);--white:#FFFFFF;
  --shadow:0 8px 32px rgba(106,90,205,.14);
  --shadow-lg:0 24px 64px rgba(106,90,205,.22);
  --card-r:20px;
  --green:#22C55E;--red:#EF4444;--orange:#F59E0B;
  --cardio:#FF6B6B;--cardio-lt:#FFF0F0;--cardio-dk:#CC3333;
  --force:#5B8DEF;--force-lt:#EEF3FF;
  --souplesse:#43D39E;--souplesse-lt:#EAFAF4;
  --endurance:#F7B731;--endurance-lt:#FFF8E6;
  --perte:#FD7272;--perte-lt:#FFF0F0;
}

html,body{font-family:'DM Sans',sans-serif;background:#F0EEFE;color:var(--tx);overflow-x:hidden}

/* ─── HERO ─── */
.hero{
  position:relative;height:400px;overflow:hidden;
  background:linear-gradient(135deg,#1A1035 0%,#2D1B69 40%,#4B3B9E 100%);
}
.hero-bg{
  position:absolute;inset:0;width:100%;height:100%;
  object-fit:cover;z-index:0;opacity:.35;
  filter:brightness(.7) saturate(1.3);
  transform:scale(1.04);transition:transform 8s ease;
}
.hero:hover .hero-bg{transform:scale(1)}
.hero-particles{position:absolute;inset:0;z-index:1;overflow:hidden}
.hero-particles::before,.hero-particles::after{
  content:'';position:absolute;border-radius:50%;
  background:rgba(106,90,205,.3);filter:blur(60px);
  animation:float 7s ease-in-out infinite;
}
.hero-particles::before{width:400px;height:400px;top:-100px;left:-80px;animation-delay:0s}
.hero-particles::after{width:300px;height:300px;bottom:-60px;right:10%;animation-delay:3.5s}
@keyframes float{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-30px) scale(1.07)}}
.hero-glow{
  position:absolute;inset:0;z-index:2;
  background:linear-gradient(135deg,rgba(29,16,80,.65) 0%,rgba(75,59,158,.4) 60%,rgba(139,127,212,.2) 100%);
}
.hero-bottom-fade{
  position:absolute;bottom:0;left:0;right:0;height:80px;z-index:3;
  background:linear-gradient(to bottom,transparent,#F0EEFE);
}
.hero-content{
  position:relative;z-index:4;height:100%;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 56px;gap:32px;
}
.hero-left{max-width:520px}
.hero-eyebrow{
  display:inline-flex;align-items:center;gap:7px;
  background:rgba(255,255,255,.12);backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.2);border-radius:30px;
  padding:5px 14px;font-size:11px;font-weight:600;color:rgba(255,255,255,.85);
  letter-spacing:.6px;text-transform:uppercase;margin-bottom:14px;
}
.hero-eyebrow-dot{width:6px;height:6px;border-radius:50%;background:#43D39E;animation:pulse-dot 2s infinite}
@keyframes pulse-dot{0%,100%{box-shadow:0 0 0 0 rgba(67,211,158,.5)}70%{box-shadow:0 0 0 6px rgba(67,211,158,0)}}
.hero-title{
  font-family:'Space Grotesk',sans-serif;
  font-size:46px;font-weight:700;line-height:1.1;
  color:white;letter-spacing:-1.5px;margin-bottom:12px;
  text-shadow:0 4px 20px rgba(0,0,0,.3);
}
.hero-title span{
  background:linear-gradient(90deg,#C3B1FF,#A78BFA,#7C3AED);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.hero-sub{font-size:15px;color:rgba(255,255,255,.65);font-weight:300;letter-spacing:.2px}
.hero-stats{display:flex;gap:14px;flex-shrink:0}
.hstat{
  background:rgba(255,255,255,.1);backdrop-filter:blur(16px);
  border:1px solid rgba(255,255,255,.2);border-radius:18px;
  padding:18px 22px;text-align:center;min-width:100px;
  transition:background .2s,transform .2s;cursor:default;
}
.hstat:hover{background:rgba(255,255,255,.18);transform:translateY(-3px)}
.hstat-icon{font-size:20px;margin-bottom:4px}
.hstat-val{
  font-family:'Space Grotesk',sans-serif;font-size:30px;font-weight:700;
  color:white;line-height:1;text-shadow:0 2px 10px rgba(0,0,0,.2);
}
.hstat-lbl{font-size:10px;color:rgba(255,255,255,.6);margin-top:4px;text-transform:uppercase;letter-spacing:.7px;font-weight:500}
.hstat.gold .hstat-val{background:linear-gradient(135deg,#FFD700,#FFA500);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hstat.teal .hstat-val{background:linear-gradient(135deg,#43D39E,#26A69A);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hstat.coral .hstat-val{background:linear-gradient(135deg,#FF6B6B,#FF8E53);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

/* ─── LAYOUT ─── */
.page{max-width:1320px;margin:0 auto;padding:32px 40px 100px;display:grid;grid-template-columns:1fr 360px;gap:26px;align-items:start}
.main-col{display:flex;flex-direction:column;gap:22px}
.side-col{display:flex;flex-direction:column;gap:22px;position:sticky;top:78px}

/* ─── CARDS ─── */
.card{background:var(--white);border:1px solid rgba(106,90,205,.09);border-radius:var(--card-r);overflow:hidden;box-shadow:0 2px 16px rgba(106,90,205,.06)}
.card-head{padding:18px 24px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.card-title{font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:700;color:var(--tx);display:flex;align-items:center;gap:9px}
.card-body{padding:20px 24px}
.section-tag{font-size:10.5px;color:var(--tx-muted);background:var(--pu-ghost);padding:3px 10px;border-radius:20px;font-weight:500;border:1px solid var(--border)}

/* ─── FILTER BAR ─── */
.cat-filters{display:flex;gap:8px;flex-wrap:wrap;padding:16px 20px}
.cat-btn{
  display:inline-flex;align-items:center;gap:6px;padding:8px 16px;
  border-radius:30px;border:1.5px solid var(--border);
  background:var(--white);font-family:'DM Sans',sans-serif;
  font-size:12.5px;font-weight:600;color:var(--tx-mid);
  cursor:pointer;transition:all .2s;white-space:nowrap;
}
.cat-btn:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(106,90,205,.12)}
.cat-btn.active.all{background:linear-gradient(135deg,var(--pu),var(--pu-lt));border-color:transparent;color:white;box-shadow:0 4px 14px rgba(106,90,205,.35)}
.cat-btn.active.cardio{background:linear-gradient(135deg,#FF6B6B,#FF8E53);border-color:transparent;color:white;box-shadow:0 4px 14px rgba(255,107,107,.35)}
.cat-btn.active.force{background:linear-gradient(135deg,#5B8DEF,#667eea);border-color:transparent;color:white;box-shadow:0 4px 14px rgba(91,141,239,.35)}
.cat-btn.active.souplesse{background:linear-gradient(135deg,#43D39E,#26A69A);border-color:transparent;color:white;box-shadow:0 4px 14px rgba(67,211,158,.35)}
.cat-btn.active.endurance{background:linear-gradient(135deg,#F7B731,#FFA502);border-color:transparent;color:white;box-shadow:0 4px 14px rgba(247,183,49,.35)}
.cat-btn.active.perte{background:linear-gradient(135deg,#FD7272,#EB4D4B);border-color:transparent;color:white;box-shadow:0 4px 14px rgba(253,114,114,.35)}

/* ─── EXERCISE GRID ─── */
.lib-header{padding:16px 22px 0;display:flex;align-items:center;justify-content:space-between}
.lib-search{display:flex;align-items:center;gap:8px;padding:0 20px 14px}
.lib-search input{flex:1;padding:9px 14px;border:1.5px solid var(--border);border-radius:30px;font-family:'DM Sans',sans-serif;font-size:13px;color:var(--tx);background:var(--pu-ghost);outline:none;transition:border-color .15s,box-shadow .15s}
.lib-search input:focus{border-color:var(--pu);box-shadow:0 0 0 3px rgba(106,90,205,.1)}
.ex-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;padding:4px}
.ex-card{
  background:var(--white);border:1.5px solid var(--border);
  border-radius:18px;overflow:hidden;cursor:pointer;
  transition:all .22s cubic-bezier(.34,1.56,.64,1);
  position:relative;
}
.ex-card:hover{transform:translateY(-5px) scale(1.01);box-shadow:0 16px 40px rgba(106,90,205,.18)}
.ex-card.selected{border-color:var(--pu);box-shadow:0 0 0 3px rgba(106,90,205,.2),0 12px 30px rgba(106,90,205,.15)}
.ex-card.selected::after{content:'✓';position:absolute;top:10px;left:10px;width:22px;height:22px;background:var(--pu);border-radius:50%;color:white;font-size:11px;font-weight:700;display:grid;place-items:center;z-index:5}
.ex-thumb{
  height:110px;display:flex;align-items:center;justify-content:center;
  font-size:44px;position:relative;overflow:hidden;
}
.ex-thumb.cardio{background:linear-gradient(135deg,#FFE5E5,#FFCCCC)}
.ex-thumb.force{background:linear-gradient(135deg,#EEF3FF,#D9E6FF)}
.ex-thumb.souplesse{background:linear-gradient(135deg,#EAFAF4,#C8F4E5)}
.ex-thumb.endurance{background:linear-gradient(135deg,#FFF8E6,#FFE9A0)}
.ex-thumb.perte{background:linear-gradient(135deg,#FFF0F0,#FFCCCC)}
.ex-thumb-icon{font-size:46px;filter:drop-shadow(0 4px 8px rgba(0,0,0,.15));z-index:1;position:relative;transition:transform .2s}
.ex-card:hover .ex-thumb-icon{transform:scale(1.15) rotate(-5deg)}
.ex-badge{
  position:absolute;top:8px;right:8px;z-index:2;
  font-size:9.5px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;
  padding:3px 8px;border-radius:20px;backdrop-filter:blur(4px);
}
.ex-badge.cardio{background:#FF6B6B;color:white}
.ex-badge.force{background:#5B8DEF;color:white}
.ex-badge.souplesse{background:#43D39E;color:white}
.ex-badge.endurance{background:#F7B731;color:white}
.ex-badge.perte{background:#FD7272;color:white}
.ex-body{padding:11px 14px 4px}
.ex-name{font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:700;color:var(--tx);margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ex-type{font-size:10.5px;color:var(--tx-muted);font-weight:400}
.ex-actions{display:flex;gap:6px;padding:8px 14px 12px}
.btn-video{
  flex:1;padding:7px 6px;border-radius:10px;border:none;
  background:linear-gradient(135deg,#667eea,#764ba2);
  color:white;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;
  cursor:pointer;transition:all .18s;display:flex;align-items:center;justify-content:center;gap:4px;
  box-shadow:0 3px 10px rgba(102,126,234,.3);
}
.btn-video:hover{box-shadow:0 5px 16px rgba(102,126,234,.45);transform:translateY(-1px)}
.btn-fav{
  flex:1;padding:7px 6px;border-radius:10px;border:none;
  background:linear-gradient(135deg,#FFF3CD,#FFE0A3);
  color:#B45309;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;
  cursor:pointer;transition:all .18s;display:flex;align-items:center;justify-content:center;gap:4px;
  border:1px solid #FDE68A;
}
.btn-fav:hover{background:linear-gradient(135deg,#FDE68A,#FBBF24);box-shadow:0 4px 12px rgba(245,158,11,.3);transform:translateY(-1px)}
.btn-fav.active{background:linear-gradient(135deg,#F59E0B,#D97706);color:white;border-color:transparent;box-shadow:0 4px 12px rgba(245,158,11,.4)}

/* ─── LOG FORM ─── */
.log-card{
  background:var(--white);border-radius:var(--card-r);overflow:hidden;
  border:1.5px solid rgba(106,90,205,.15);
  box-shadow:var(--shadow);
}
.log-header{
  padding:20px 26px 16px;
  background:linear-gradient(135deg,var(--pu-deep) 0%,#3D2A8A 60%,#5E3EB5 100%);
  display:flex;align-items:center;gap:14px;
}
.log-header-icon{width:46px;height:46px;border-radius:14px;background:rgba(255,255,255,.15);display:grid;place-items:center;font-size:22px;flex-shrink:0}
.log-header-text h3{font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:700;color:white}
.log-header-text p{font-size:11.5px;color:rgba(255,255,255,.6);margin-top:2px}
.log-steps{display:flex;gap:0;padding:0 26px;background:var(--pu-ghost);border-bottom:1px solid var(--border)}
.log-step{flex:1;padding:11px 14px;display:flex;align-items:center;gap:8px;font-size:11.5px;font-weight:600;color:var(--tx-muted);position:relative;cursor:default}
.log-step::after{content:'›';position:absolute;right:-2px;font-size:16px;color:var(--border)}
.log-step:last-child::after{display:none}
.log-step .step-num{width:22px;height:22px;border-radius:50%;background:var(--border);display:grid;place-items:center;font-size:10px;font-weight:700;color:var(--tx-muted);flex-shrink:0}
.log-step.done .step-num{background:var(--green);color:white}
.log-step.active .step-num{background:var(--pu);color:white}
.log-step.active{color:var(--pu)}
.log-body{padding:22px 26px}
.sel-ex-banner{
  display:none;padding:14px 16px;border-radius:14px;margin-bottom:18px;
  background:linear-gradient(135deg,var(--pu-pale),var(--pu-ghost));
  border:1.5px solid rgba(106,90,205,.2);
  align-items:center;gap:13px;
}
.sel-ex-banner.show{display:flex;animation:fadeUp .28s ease}
.sel-ex-emoji{font-size:30px;filter:drop-shadow(0 3px 6px rgba(0,0,0,.1))}
.sel-ex-info{flex:1}
.sel-ex-name{font-family:'Space Grotesk',sans-serif;font-size:14.5px;font-weight:700;color:var(--pu)}
.sel-ex-type{font-size:11px;color:var(--tx-muted);margin-top:2px}
.sel-ex-badge{font-size:10px;background:var(--pu);color:white;padding:2px 8px;border-radius:20px;font-weight:600;margin-top:4px;display:inline-block}
.log-form{display:flex;flex-direction:column;gap:14px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form-group{display:flex;flex-direction:column;gap:5px}
.form-group.full{grid-column:1/-1}
.flabel{font-size:11px;font-weight:700;color:var(--tx-mid);text-transform:uppercase;letter-spacing:.5px;display:flex;align-items:center;gap:5px}
.flabel span{font-size:13px}
.finput{
  padding:10px 14px;border:1.5px solid var(--border);border-radius:11px;
  font-family:'DM Sans',sans-serif;font-size:13.5px;color:var(--tx);
  background:var(--pu-ghost);outline:none;transition:all .2s;width:100%;
}
.finput:focus{border-color:var(--pu);background:white;box-shadow:0 0 0 3px rgba(106,90,205,.08)}
.finput.error{border-color:var(--red);background:#FFF5F5}
textarea.finput{resize:vertical;min-height:72px;line-height:1.55}
.err-msg{font-size:11px;color:var(--red);display:none;font-weight:600;align-items:center;gap:4px}
.err-msg.show{display:flex}
.btn-log{
  width:100%;padding:14px;border-radius:14px;border:none;
  background:linear-gradient(135deg,var(--pu) 0%,#9B59B6 50%,#7C3AED 100%);
  color:white;font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:700;
  cursor:pointer;transition:all .2s;
  display:flex;align-items:center;justify-content:center;gap:10px;
  position:relative;overflow:hidden;
  box-shadow:0 6px 20px rgba(106,90,205,.35);
  margin-top:4px;
}
.btn-log::after{
  content:'';position:absolute;top:-50%;left:-80%;width:60%;height:200%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.18),transparent);
  transform:skewX(-15deg);transition:left .5s;
}
.btn-log:hover::after{left:120%}
.btn-log:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(106,90,205,.45)}
.btn-log:disabled{background:var(--tx-muted);cursor:not-allowed;transform:none;box-shadow:none}

.map-card .map-actions{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}
.map-control-btn{width:42px;height:42px;border:none;border-radius:14px;background:rgba(106,90,205,.1);color:var(--pu-deep);font-size:18px;cursor:pointer;display:grid;place-items:center;box-shadow:0 8px 18px rgba(106,90,205,.08);transition:all .18s}
.map-control-btn:hover{background:rgba(106,90,205,.16);transform:translateY(-1px)}
.map-control-btn.active{background:linear-gradient(135deg,#6A5ACD,#8B7FD4);color:white}
.map-meta{display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--tx-mid)}
.map-meta strong{color:var(--tx)}
#activityMap{width:100%;height:380px;min-height:380px;border-radius:20px;box-shadow:0 18px 36px rgba(106,90,205,.12);background:#eef2ff;position:relative;display:block;}
#activityMap .leaflet-container{width:100% !important;height:100% !important;display:block !important;border-radius:20px;overflow:hidden}

/* ─── SESSIONS HISTORY (timeline) ─── */
.timeline{display:flex;flex-direction:column;gap:0;position:relative}
.timeline::before{
  content:'';position:absolute;left:20px;top:0;bottom:0;width:2px;
  background:linear-gradient(to bottom,var(--pu),rgba(106,90,205,.1));
  border-radius:2px;
}
.session-block{
  margin-left:46px;margin-bottom:16px;border-radius:18px;overflow:hidden;
  background:var(--white);border:1px solid rgba(106,90,205,.1);
  box-shadow:0 2px 14px rgba(106,90,205,.06);
  transition:box-shadow .2s;
  position:relative;
}
.session-block::before{
  content:'';position:absolute;left:-34px;top:20px;width:12px;height:12px;
  border-radius:50%;background:var(--pu);border:3px solid var(--pu-ghost);
  box-shadow:0 0 0 3px rgba(106,90,205,.2);
  z-index:1;
}
.session-block:hover{box-shadow:0 8px 28px rgba(106,90,205,.12)}
.session-head{
  padding:14px 20px;
  background:linear-gradient(90deg,var(--pu-ghost) 0%,white 100%);
  display:flex;align-items:center;justify-content:space-between;
  cursor:pointer;border-bottom:1px solid rgba(106,90,205,.07);
}
.session-date-group{display:flex;flex-direction:column;gap:2px}
.session-date-big{font-family:'Space Grotesk',sans-serif;font-size:14px;font-weight:700;color:var(--pu)}
.session-date-rel{font-size:10.5px;color:var(--tx-muted);font-weight:400}
.session-tags{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.session-tag{font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px}
.session-tag.ex{background:var(--pu-pale);color:var(--pu)}
.session-tag.time{background:#E8F8F1;color:#0B7A4C}
.session-tag.cal{background:#FFF3E0;color:#B45309}
.session-actions{display:flex;align-items:center;gap:8px}
.btn-del-session{
  padding:5px 12px;border-radius:10px;border:1.5px solid rgba(239,68,68,.25);
  background:transparent;color:#DC2626;font-size:11px;font-weight:700;
  font-family:'DM Sans',sans-serif;cursor:pointer;transition:all .18s;
  display:flex;align-items:center;gap:5px;
}
.btn-del-session:hover{background:#FEE2E2;border-color:#DC2626;box-shadow:0 3px 10px rgba(220,38,38,.2)}
.session-chevron{width:24px;height:24px;border-radius:7px;background:var(--pu-ghost);display:grid;place-items:center;color:var(--tx-muted);font-size:10px;transition:all .2s;border:1px solid var(--border)}
.session-chevron.open{transform:rotate(180deg);background:var(--pu-pale);color:var(--pu)}
.session-exercises{display:none;padding:12px 16px 14px}
.session-exercises.open{display:block;animation:fadeUp .22s ease}
.ex-row{
  display:flex;align-items:center;gap:12px;padding:10px 14px;
  border-radius:13px;margin-bottom:7px;background:var(--pu-ghost);
  border:1.5px solid transparent;transition:all .18s;
}
.ex-row:last-child{margin-bottom:0}
.ex-row:hover{background:white;border-color:rgba(106,90,205,.15);box-shadow:0 3px 12px rgba(106,90,205,.07)}
.ex-row-dot{
  width:40px;height:40px;border-radius:12px;display:grid;place-items:center;
  font-size:20px;flex-shrink:0;
}
.ex-row-dot.cardio{background:linear-gradient(135deg,#FFE5E5,#FFCCCC)}
.ex-row-dot.force{background:linear-gradient(135deg,#EEF3FF,#D9E6FF)}
.ex-row-dot.souplesse{background:linear-gradient(135deg,#EAFAF4,#C8F4E5)}
.ex-row-dot.endurance{background:linear-gradient(135deg,#FFF8E6,#FFE9A0)}
.ex-row-dot.perte{background:linear-gradient(135deg,#FFF0F0,#FFCCCC)}
.ex-row-info{flex:1;min-width:0}
.ex-row-name{font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:700;color:var(--tx);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ex-row-meta{display:flex;gap:10px;margin-top:3px;flex-wrap:wrap}
.ex-meta-tag{font-size:11px;color:var(--tx-muted);display:flex;align-items:center;gap:3px;font-weight:500}
.ex-row-actions{display:flex;gap:6px;flex-shrink:0}
.btn-edit-ex{
  width:32px;height:32px;border-radius:10px;border:1.5px solid rgba(91,141,239,.25);
  background:rgba(91,141,239,.07);cursor:pointer;
  display:grid;place-items:center;font-size:14px;
  transition:all .18s;color:#5B8DEF;
}
.btn-edit-ex:hover{background:rgba(91,141,239,.2);border-color:#5B8DEF;box-shadow:0 3px 10px rgba(91,141,239,.25);transform:translateY(-1px)}
.btn-del-ex{
  width:32px;height:32px;border-radius:10px;border:1.5px solid rgba(239,68,68,.2);
  background:rgba(239,68,68,.06);cursor:pointer;
  display:grid;place-items:center;font-size:14px;
  transition:all .18s;color:#DC2626;
}
.btn-del-ex:hover{background:rgba(239,68,68,.15);border-color:#DC2626;box-shadow:0 3px 10px rgba(239,68,68,.2);transform:translateY(-1px)}

/* ─── STATS SIDEBAR ─── */
.stats-card{background:var(--white);border-radius:var(--card-r);overflow:hidden;border:1px solid rgba(106,90,205,.09);box-shadow:0 2px 16px rgba(106,90,205,.06)}
.stats-header{
  padding:18px 22px 14px;
  background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);
}
.stats-header-title{font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:700;color:white;display:flex;align-items:center;gap:8px}
.stats-kpis{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:16px 16px 8px}
.kpi{border-radius:14px;padding:13px 14px;text-align:center;position:relative;overflow:hidden;border:1px solid transparent;transition:transform .18s}
.kpi:hover{transform:translateY(-2px)}
.kpi.purple{background:linear-gradient(135deg,#EDE8FA,#F7F5FD);border-color:rgba(106,90,205,.18)}
.kpi.green{background:linear-gradient(135deg,#E8FDF5,#F0FAF7);border-color:rgba(67,211,158,.2)}
.kpi.orange{background:linear-gradient(135deg,#FFF8E6,#FDFAF0);border-color:rgba(247,183,49,.2)}
.kpi.blue{background:linear-gradient(135deg,#EEF3FF,#F5F7FF);border-color:rgba(91,141,239,.2)}
.kpi-icon{font-size:18px;margin-bottom:5px}
.kpi-val{font-family:'Space Grotesk',sans-serif;font-size:22px;font-weight:700;line-height:1}
.kpi.purple .kpi-val{color:var(--pu)}
.kpi.green .kpi-val{color:#0B7A4C}
.kpi.orange .kpi-val{color:#B45309}
.kpi.blue .kpi-val{color:#1D4ED8}
.kpi-lbl{font-size:10px;color:var(--tx-muted);margin-top:3px;font-weight:500;text-transform:uppercase;letter-spacing:.3px}
.chart-wrap{padding:0 16px 16px;position:relative}
.chart-wrap canvas{max-height:180px}
.chart-legend{display:flex;flex-direction:column;gap:6px;padding:4px 16px 16px}
.legend-item{display:flex;align-items:center;justify-content:space-between;gap:8px}
.legend-dot-label{display:flex;align-items:center;gap:8px}
.legend-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.legend-name{font-size:12px;color:var(--tx-mid);font-weight:500}
.legend-bar-wrap{flex:1;height:4px;background:var(--pu-ghost);border-radius:4px;overflow:hidden;max-width:70px}
.legend-bar{height:100%;border-radius:4px;transition:width .6s ease}
.legend-count{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:600;color:var(--tx-muted);min-width:18px;text-align:right}

/* ─── FAVORITES ─── */
.fav-grid{display:flex;flex-direction:column;gap:8px}
.fav-item{
  display:flex;align-items:center;gap:11px;padding:10px 13px;
  border-radius:13px;background:var(--pu-ghost);border:1.5px solid transparent;
  transition:all .18s;cursor:default;
}
.fav-item:hover{background:white;border-color:rgba(106,90,205,.15);box-shadow:0 4px 14px rgba(106,90,205,.09)}
.fav-emoji{font-size:22px;flex-shrink:0}
.fav-info{flex:1;min-width:0}
.fav-name{font-family:'Space Grotesk',sans-serif;font-size:12.5px;font-weight:700;color:var(--tx);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fav-type{font-size:10.5px;color:var(--tx-muted);margin-top:1px}
.fav-type-badge{display:inline-block;font-size:9.5px;padding:1.5px 7px;border-radius:10px;font-weight:600;margin-top:3px}
.fav-type-badge.cardio{background:#FFE5E5;color:#CC3333}
.fav-type-badge.force{background:#EEF3FF;color:#1D4ED8}
.fav-type-badge.souplesse{background:#EAFAF4;color:#065F46}
.fav-type-badge.endurance{background:#FFF8E6;color:#92400E}
.fav-type-badge.perte{background:#FFF0F0;color:#991B1B}
.fav-remove{
  width:26px;height:26px;border-radius:8px;border:none;
  background:transparent;cursor:pointer;color:var(--tx-muted);
  font-size:11px;display:grid;place-items:center;transition:all .15s;
  flex-shrink:0;
}
.fav-remove:hover{background:#FEE2E2;color:#DC2626}
.fav-empty{text-align:center;padding:24px 16px;color:var(--tx-muted)}
.fav-empty-icon{font-size:32px;margin-bottom:8px;opacity:.4}
.fav-empty-text{font-size:12.5px;font-weight:500}

/* ─── AI COACH ─── */
.ai-card{
  border-radius:var(--card-r);overflow:hidden;
  background:linear-gradient(135deg,#1A1035 0%,#2D1B69 60%,#3D2A8A 100%);
  border:1px solid rgba(255,255,255,.1);
  box-shadow:0 8px 30px rgba(26,16,53,.3);
}
.ai-top{padding:14px 18px;display:flex;align-items:center;gap:11px;border-bottom:1px solid rgba(255,255,255,.1)}
.ai-avatar{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.15);display:grid;place-items:center;font-size:19px}
.ai-name{font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:700;color:white}
.ai-online{display:flex;align-items:center;gap:5px;font-size:10px;color:rgba(255,255,255,.55);margin-top:2px}
.ai-dot{width:5px;height:5px;border-radius:50%;background:#43D39E;animation:blink 1.8s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.ai-msgs{padding:14px;height:190px;overflow-y:auto;display:flex;flex-direction:column;gap:9px}
.ai-msgs::-webkit-scrollbar{width:3px}
.ai-msgs::-webkit-scrollbar-thumb{background:rgba(255,255,255,.2);border-radius:3px}
.ai-bubble{max-width:85%;border-radius:13px;padding:9px 13px;font-size:12px;line-height:1.55}
.ai-bubble.bot{background:rgba(255,255,255,.12);color:rgba(255,255,255,.9);border-bottom-left-radius:3px;align-self:flex-start}
.ai-bubble.user{background:rgba(255,255,255,.22);color:white;font-weight:500;border-bottom-right-radius:3px;align-self:flex-end}
.ai-thinking{display:flex;gap:4px;align-items:center;padding:9px 13px;background:rgba(255,255,255,.12);border-radius:13px;border-bottom-left-radius:3px;align-self:flex-start;display:none}
.ai-thinking.show{display:flex}
.think-dot{width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.6)}
.think-dot:nth-child(1){animation:bounce .8s 0s infinite}
.think-dot:nth-child(2){animation:bounce .8s .15s infinite}
.think-dot:nth-child(3){animation:bounce .8s .3s infinite}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.ai-input-row{padding:10px 14px;border-top:1px solid rgba(255,255,255,.1);display:flex;gap:8px}
.ai-input{flex:1;padding:9px 13px;border-radius:10px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.1);color:white;font-family:'DM Sans',sans-serif;font-size:12.5px;outline:none}
.ai-input::placeholder{color:rgba(255,255,255,.35)}
.ai-input:focus{border-color:rgba(255,255,255,.4)}
.ai-send{width:36px;height:36px;border-radius:10px;border:none;background:rgba(255,255,255,.2);color:white;cursor:pointer;display:grid;place-items:center;font-size:14px;transition:background .15s}
.ai-send:hover{background:rgba(255,255,255,.35)}

/* ─── MODALS ─── */
.modal-overlay{position:fixed;inset:0;background:rgba(20,15,50,.65);backdrop-filter:blur(8px);z-index:1000;display:none;align-items:center;justify-content:center;padding:20px}
.modal-overlay.open{display:flex}
.modal{background:var(--white);border-radius:24px;width:100%;max-width:520px;overflow:hidden;animation:slideUp .28s cubic-bezier(.34,1.56,.64,1)}
@keyframes slideUp{from{opacity:0;transform:translateY(24px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.modal-head{padding:20px 24px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.modal-title{font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:700;color:var(--tx)}
.modal-close{width:30px;height:30px;border-radius:9px;border:none;background:var(--pu-ghost);cursor:pointer;font-size:14px;display:grid;place-items:center;color:var(--tx-muted);transition:all .15s}
.modal-close:hover{background:var(--pu-pale);color:var(--pu)}
.modal-body{padding:24px}
.video-wrap{width:100%;padding-top:56.25%;border-radius:13px;background:#1A1035;position:relative;overflow:hidden}
.video-wrap iframe{position:absolute;inset:0;width:100%;height:100%;border:none}
.edit-form{display:flex;flex-direction:column;gap:13px}
.edit-row{display:grid;grid-template-columns:1fr 1fr;gap:11px}

/* ─── DELETE MODAL ─── */
.del-modal-inner{display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center}
.del-icon-wrap{width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#FEE2E2,#FECACA);display:grid;place-items:center;font-size:28px;box-shadow:0 4px 16px rgba(239,68,68,.2)}
.del-title{font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:700;color:var(--tx);margin-bottom:4px}
.del-sub{font-size:13px;color:var(--tx-mid)}
.del-warn{font-size:11px;color:var(--tx-muted);margin-top:4px}
.del-btns{display:flex;gap:10px;width:100%;margin-top:4px}
.btn-cancel{flex:1;padding:12px;border-radius:12px;border:1.5px solid var(--border);background:var(--white);font-family:'DM Sans',sans-serif;font-size:13.5px;font-weight:600;color:var(--tx-mid);cursor:pointer;transition:background .15s}
.btn-cancel:hover{background:var(--pu-ghost)}
.btn-delete{flex:1;padding:12px;border-radius:12px;border:none;background:linear-gradient(135deg,#EF4444,#DC2626);font-family:'Space Grotesk',sans-serif;font-size:13.5px;font-weight:700;color:white;cursor:pointer;transition:all .18s;display:flex;align-items:center;justify-content:center;gap:7px;box-shadow:0 4px 14px rgba(239,68,68,.3)}
.btn-delete:hover{box-shadow:0 6px 20px rgba(239,68,68,.4);transform:translateY(-1px)}

/* ─── TOAST ─── */
.toast{position:fixed;bottom:26px;right:26px;z-index:2000;padding:13px 18px;border-radius:14px;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;display:flex;align-items:center;gap:9px;transform:translateY(80px);opacity:0;transition:all .3s cubic-bezier(.34,1.56,.64,1);max-width:340px;box-shadow:0 8px 24px rgba(0,0,0,.12)}
.toast.show{transform:translateY(0);opacity:1}
.toast.success{background:white;color:#065F46;border:1.5px solid #A7F3D0;box-shadow:0 8px 24px rgba(0,0,0,.1)}
.toast.error{background:white;color:#991B1B;border:1.5px solid #FCA5A5}
.toast.info{background:white;color:var(--pu-dk);border:1.5px solid rgba(106,90,205,.25)}

/* ─── PDF EXPORT BUTTONS (barre fixe) ─── */
.pdf-bar{
  position:fixed;bottom:30px;left:50%;transform:translateX(-50%);
  display:flex;gap:10px;align-items:center;z-index:999;
}
.btn-pdf{
  padding:13px 24px;border-radius:30px;border:none;
  background:linear-gradient(135deg,#1A1035,#4B3B9E);
  color:white;font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:700;
  cursor:pointer;display:flex;align-items:center;gap:9px;
  box-shadow:0 8px 28px rgba(26,16,53,.4);transition:all .22s;
  border:1px solid rgba(255,255,255,.15);
}
.btn-pdf:hover{transform:translateY(-3px);box-shadow:0 14px 36px rgba(26,16,53,.5)}
.btn-pdf:active{transform:translateY(-1px)}
.btn-pdf-server{
  padding:13px 24px;border-radius:30px;border:none;
  background:linear-gradient(135deg,#6a1b9a,#9c27b0);
  color:white;font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:700;
  cursor:pointer;display:flex;align-items:center;gap:9px;
  box-shadow:0 8px 28px rgba(106,27,154,.4);transition:all .22s;
  border:1px solid rgba(255,255,255,.15);text-decoration:none;
}
.btn-pdf-server:hover{transform:translateY(-3px);box-shadow:0 14px 36px rgba(106,27,154,.55)}

/* ─── QR BUTTON (dans chaque session) ─── */
.btn-qr-session{
  padding:5px 12px;border-radius:10px;border:1.5px solid rgba(106,27,154,.25);
  background:linear-gradient(135deg,#EDE8FA,#F7F5FD);
  color:#6a1b9a;font-size:11px;font-weight:700;
  font-family:'DM Sans',sans-serif;cursor:pointer;transition:all .18s;
  display:flex;align-items:center;gap:5px;
}
.btn-qr-session:hover{background:linear-gradient(135deg,#6a1b9a,#9c27b0);color:white;border-color:transparent;box-shadow:0 3px 10px rgba(106,27,154,.35)}

/* ─── QR MODAL ─── */
.qr-modal-body{display:flex;flex-direction:column;align-items:center;gap:18px;padding:8px 0}
.qr-img-wrap{
  width:240px;height:240px;border-radius:20px;overflow:hidden;
  border:3px solid rgba(106,27,154,.15);
  box-shadow:0 8px 28px rgba(106,27,154,.18);
  background:white;display:flex;align-items:center;justify-content:center;
}
.qr-img-wrap img{width:100%;height:100%;object-fit:contain}
.qr-loading{font-size:32px;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.qr-session-info{text-align:center}
.qr-session-date{font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:700;color:var(--pu)}
.qr-session-meta{font-size:12px;color:var(--tx-muted);margin-top:4px}
.qr-hint{font-size:11.5px;color:var(--tx-muted);text-align:center;max-width:260px;line-height:1.55}
.btn-wa{
  display:flex;align-items:center;justify-content:center;gap:9px;
  padding:13px 28px;border-radius:14px;border:none;
  background:linear-gradient(135deg,#25D366,#128C7E);
  color:white;font-family:'Space Grotesk',sans-serif;font-size:14px;font-weight:700;
  cursor:pointer;transition:all .2s;width:100%;
  box-shadow:0 6px 18px rgba(37,211,102,.35);text-decoration:none;
}
.btn-wa:hover{box-shadow:0 10px 26px rgba(37,211,102,.5);transform:translateY(-2px)}

/* ─── EMPTY STATES ─── */
.empty{text-align:center;padding:38px 20px;color:var(--tx-muted)}
.empty-icon{font-size:40px;margin-bottom:10px;opacity:.4}
.empty-txt{font-size:13px;font-weight:500}

/* ─── ANIMATIONS ─── */
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.fade{animation:fadeUp .38s ease both}
.d1{animation-delay:.07s}.d2{animation-delay:.14s}.d3{animation-delay:.21s}
@keyframes countUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* ─── RESPONSIVE ─── */
@media(max-width:1100px){.page{grid-template-columns:1fr;padding:22px 20px 100px}.side-col{position:static}}
@media(max-width:680px){.hero-content{flex-direction:column;align-items:flex-start;padding:24px 22px;gap:18px}.hero{height:auto;min-height:360px}.hero-title{font-size:32px}.hero-stats{flex-wrap:wrap;gap:10px}.form-row,.edit-row{grid-template-columns:1fr}.ex-grid{grid-template-columns:repeat(auto-fill,minmax(165px,1fr))}.log-steps{display:none}}
</style>
{% endblock %}

{% block body %}
{% include '_planning_topbar.html.twig' %}

{# ══════════════ HERO BANNER ══════════════ #}
<div class="hero">
  <img class="hero-bg"
    src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1600&q=85&auto=format&fit=crop"
    alt="Salle de sport"
    onerror="this.src='https://images.unsplash.com/photo-1571902943202-507ec2618e8f?w=1600&q=80'">
  <div class="hero-particles"></div>
  <div class="hero-glow"></div>
  <div class="hero-bottom-fade"></div>
  <div class="hero-content">
    <div class="hero-left">
      <div class="hero-eyebrow">
        <span class="hero-eyebrow-dot"></span>
        Journal de Sport · Harmony
      </div>
      <h1 class="hero-title">🏋️ Journal<br>d'<span>Exercices</span></h1>
      <p class="hero-sub">Planifiez, suivez et progressez — connecté à votre base de données.</p>
    </div>
    <div class="hero-stats">
      <div class="hstat gold">
        <div class="hstat-icon">🏆</div>
        <div class="hstat-val" id="statSeances">{{ stats.sessions }}</div>
        <div class="hstat-lbl">Séances</div>
      </div>
      <div class="hstat teal">
        <div class="hstat-icon">⏱️</div>
        <div class="hstat-val" id="statMinutes">{{ stats.minutes }}</div>
        <div class="hstat-lbl">Minutes</div>
      </div>
      <div class="hstat coral">
        <div class="hstat-icon">🔥</div>
        <div class="hstat-val" id="statCalories">{{ stats.calories }}</div>
        <div class="hstat-lbl">Calories</div>
      </div>
    </div>
  </div>
</div>

{# ══════════════ PAGE GRID ══════════════ #}
<div class="page">

  {# ── MAIN COLUMN ── #}
  <div class="main-col">

    {# FILTER TABS #}
    <div class="card fade">
      <div class="cat-filters">
        <button class="cat-btn active all" data-cat="all" data-cls="all">🌟 Tous</button>
        <button class="cat-btn" data-cat="Cardio" data-cls="cardio">🔴 Cardio</button>
        <button class="cat-btn" data-cat="Force" data-cls="force">💪 Force</button>
        <button class="cat-btn" data-cat="Souplesse" data-cls="souplesse">🌿 Souplesse</button>
        <button class="cat-btn" data-cat="Endurance" data-cls="endurance">⚡ Endurance</button>
        <button class="cat-btn" data-cat="Perte" data-cls="perte">🔥 Perte de poids</button>
      </div>
    </div>

    {# EXERCISE LIBRARY #}
    <div class="card fade d1">
      <div class="lib-header">
        <div class="card-title">📚 Bibliothèque d'Exercices</div>
        <span class="section-tag">Cliquez pour sélectionner</span>
      </div>
      <div class="lib-search">
        <input type="text" id="searchInput" placeholder="🔍  Rechercher un exercice..." oninput="liveSearch(this.value)">
      </div>
      <div class="card-body" style="padding-top:4px">
        <div class="ex-grid" id="exerciseGrid">
          {% for ex in exercices %}
            {% set cat = ex.typeExercice|lower %}
            {% set cls = 'force' %}
            {% if 'cardio' in cat %}{% set cls = 'cardio' %}
            {% elseif 'souplesse' in cat %}{% set cls = 'souplesse' %}
            {% elseif 'endurance' in cat %}{% set cls = 'endurance' %}
            {% elseif 'perte' in cat %}{% set cls = 'perte' %}
            {% endif %}
            {% set icon = '🏃' %}
            {% if 'cardio' in cat %}{% set icon = '🏃' %}
            {% elseif 'force' in cat and 'femme' in cat %}{% set icon = '🧘‍♀️' %}
            {% elseif 'force' in cat %}{% set icon = '💪' %}
            {% elseif 'souplesse' in cat %}{% set icon = '🧘' %}
            {% elseif 'endurance' in cat %}{% set icon = '⚡' %}
            {% elseif 'perte' in cat %}{% set icon = '🔥' %}
            {% endif %}
            <div class="ex-card"
              data-id="{{ ex.id }}"
              data-name="{{ ex.nomExercice }}"
              data-type="{{ ex.typeExercice }}"
              data-icon="{{ icon }}"
              data-video="{{ ex.videoExercice }}"
              data-cat="{{ ex.typeExercice }}"
              onclick="selectExercise(this)">
              <div class="ex-thumb {{ cls }}">
                <span class="ex-thumb-icon">{{ icon }}</span>
                <span class="ex-badge {{ cls }}">{{ ex.typeExercice|replace({'_':' '})|split(' ')|first }}</span>
              </div>
              <div class="ex-body">
                <div class="ex-name" title="{{ ex.nomExercice }}">{{ ex.nomExercice }}</div>
                <div class="ex-type">{{ ex.typeExercice|replace({'_':' '}) }}</div>
              </div>
              <div class="ex-actions">
                {% if ex.videoExercice and 'http' in ex.videoExercice %}
                  <button class="btn-video" onclick="event.stopPropagation();openVideo('{{ ex.videoExercice|e('html_attr') }}','{{ ex.nomExercice|e('html_attr') }}')">▶ Vidéo</button>
                {% else %}
                  <button class="btn-video" onclick="event.stopPropagation();showToast('info','⚠ Vidéo non disponible')">▶ Vidéo</button>
                {% endif %}
                <button class="btn-fav fav-btn"
                  data-id="{{ ex.id }}"
                  data-name="{{ ex.nomExercice|e('html_attr') }}"
                  data-type="{{ ex.typeExercice|e('html_attr') }}"
                  data-icon="{{ icon }}"
                  onclick="event.stopPropagation();toggleFav(this)">⭐ Fav</button>
              </div>
            </div>
          {% else %}
            <div class="empty" style="grid-column:1/-1"><div class="empty-icon">🔍</div><div class="empty-txt">Aucun exercice en base de données</div></div>
          {% endfor %}
        </div>
      </div>
    </div>

    {# LOG FORM #}
    <div class="log-card fade d2">
      <div class="log-header">
        <div class="log-header-icon">✏️</div>
        <div class="log-header-text">
          <h3>Enregistrer dans une Séance</h3>
          <p>Sélectionnez un exercice puis remplissez les détails</p>
        </div>
      </div>
      <div class="log-steps">
        <div class="log-step active" id="step1">
          <div class="step-num">1</div> Choisir exercice
        </div>
        <div class="log-step" id="step2">
          <div class="step-num">2</div> Détails
        </div>
        <div class="log-step" id="step3">
          <div class="step-num">3</div> Enregistrer
        </div>
      </div>
      <div class="log-body">
        <span class="err-msg" id="err-exercice" style="margin-bottom:8px">⚠ Veuillez sélectionner un exercice ci-dessus.</span>

        <div class="sel-ex-banner" id="selectedInfo">
          <div class="sel-ex-emoji" id="selectedIcon">🏃</div>
          <div class="sel-ex-info">
            <div class="sel-ex-name" id="selectedName">—</div>
            <div class="sel-ex-type" id="selectedType">—</div>
            <span class="sel-ex-badge" id="selectedBadge"></span>
          </div>
        </div>

        <form class="log-form" id="logForm" novalidate>
          <input type="hidden" id="exerciseId" value="">

          <div class="form-row">
            <div class="form-group">
              <label class="flabel"><span>⏱</span> Durée (minutes) *</label>
              <span class="err-msg" id="err-duree">⚠ Durée requise (1 – 300 min)</span>
              <input type="number" id="duree" class="finput" placeholder="Ex : 30" min="1" max="300">
            </div>
            <div class="form-group">
              <label class="flabel"><span>📅</span> Date de séance *</label>
              <span class="err-msg" id="err-date">⚠ Date requise</span>
              <input type="date" id="dateSeance" class="finput">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="flabel"><span>🔥</span> Calories brûlées</label>
              <input type="number" id="calories" class="finput" placeholder="Estimées" min="0">
            </div>
            <div class="form-group">
              <label class="flabel"><span>⚖</span> Poids (kg)</label>
              <input type="number" id="poids" class="finput" placeholder="Ex : 60" min="0" step="0.5">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="flabel"><span>🔁</span> Séries</label>
              <input type="number" id="series" class="finput" placeholder="Ex : 4" min="0">
            </div>
            <div class="form-group">
              <label class="flabel"><span>🔢</span> Répétitions</label>
              <input type="number" id="reps" class="finput" placeholder="Ex : 12" min="0">
            </div>
          </div>

          <div class="form-group full">
            <label class="flabel"><span>📝</span> Notes</label>
            <textarea id="notes" class="finput" placeholder="Observations, sensations personnelles..."></textarea>
          </div>

          <button type="submit" class="btn-log" id="submitBtn">
            <span>💾</span> Enregistrer dans la séance
          </button>
        </form>
      </div>
    </div>

    {# CARTE D'ENTRAÎNEMENT #}
    <div class="card fade d3 map-card">
      <div class="card-head">
        <div>
          <div class="card-title">🗺️ Carte d'entraînement</div>
          <div class="card-subtitle">Localisation, tracé de parcours et parcs sportifs</div>
        </div>
      </div>
      <div class="card-body">
        <div class="map-actions">
          <button type="button" class="map-control-btn" onclick="locateUser()" title="Se localiser">📍</button>
          <button type="button" class="map-control-btn" id="routeToggleBtn" onclick="toggleRouteMode()" title="Tracer mon parcours">✍️</button>
          <button type="button" class="map-control-btn" onclick="searchParks()" title="Afficher les parcs de sport">🏟️</button>
          <button type="button" class="map-control-btn" onclick="resetRoute()" title="Réinitialiser le parcours">♻️</button>
        </div>
        <div class="map-meta">
          <span id="routeInfo"><strong>Parcours :</strong> Aucun tracé</span>
          <span id="parkStatus"><strong>Parcs :</strong> Appuyez sur '🏟️' pour afficher les parcs sportifs autour de votre position.</span>
          <span><strong>Astuce :</strong> cliquez sur la carte pour ajouter des points de parcours.</span>
        </div>
        <div id="activityMap"></div>
      </div>
    </div>

    {# SESSIONS HISTORY #}
    <div class="card fade d3">
      <div class="card-head">
        <div class="card-title">📊 Historique des Séances</div>
        <span class="section-tag" id="histCount">{{ grouped|length }} séance{{ grouped|length != 1 ? 's' : '' }}</span>
      </div>
      <div class="card-body">
        <div class="timeline" id="sessionsList">

          {% if grouped is empty %}
            <div class="empty"><div class="empty-icon">📋</div><div class="empty-txt">Aucune séance enregistrée.</div></div>
          {% else %}
            {% for date, acts in grouped %}
              {% set totalMin = 0 %}
              {% set totalCal = 0 %}
              {% for a in acts %}
                {% set totalMin = totalMin + a.dureeMinutes %}
                {% set totalCal = totalCal + (a.caloriesBrulees ?: 0) %}
              {% endfor %}
              <div class="session-block" id="session-{{ date|replace({'-':''}) }}">
                <div class="session-head" onclick="toggleSession(this)">
                  <div class="session-date-group">
                    <div class="session-date-big">📅 {{ date|date('d/m/Y') }}</div>
                    <div class="session-date-rel">{{ acts|length }} exercice{{ acts|length != 1 ? 's' : '' }}</div>
                  </div>
                  <div class="session-tags">
                    <span class="session-tag ex">{{ acts|length }} ex.</span>
                    <span class="session-tag time">⏱ {{ totalMin }} min</span>
                    {% if totalCal > 0 %}<span class="session-tag cal">🔥 {{ totalCal }} kcal</span>{% endif %}
                  </div>
                  <div class="session-actions">
                    <button class="btn-qr-session" onclick="event.stopPropagation();openQR('{{ date }}')">📲 QR</button>
                    <button class="btn-del-session" onclick="event.stopPropagation();deleteSession('{{ date }}')">🗑 Supprimer</button>
                    <div class="session-chevron" id="chev-{{ date|replace({'-':''}) }}">▼</div>
                  </div>
                </div>
                <div class="session-exercises" id="sexs-{{ date|replace({'-':''}) }}">
                  {% for a in acts %}
                    {% set cat = a.exercice.typeExercice|lower %}
                    {% set icon = '🏃' %}
                    {% set cls = 'force' %}
                    {% if 'cardio' in cat %}{% set icon = '🏃' %}{% set cls = 'cardio' %}
                    {% elseif 'force' in cat and 'femme' in cat %}{% set icon = '🧘‍♀️' %}{% set cls = 'force' %}
                    {% elseif 'force' in cat %}{% set icon = '💪' %}{% set cls = 'force' %}
                    {% elseif 'souplesse' in cat %}{% set icon = '🧘' %}{% set cls = 'souplesse' %}
                    {% elseif 'endurance' in cat %}{% set icon = '⚡' %}{% set cls = 'endurance' %}
                    {% elseif 'perte' in cat %}{% set icon = '🔥' %}{% set cls = 'perte' %}
                    {% endif %}
                    <div class="ex-row" id="exrow-{{ a.id }}">
                      <div class="ex-row-dot {{ cls }}">{{ icon }}</div>
                      <div class="ex-row-info">
                        <div class="ex-row-name">{{ a.exercice.nomExercice }}</div>
                        <div class="ex-row-meta">
                          <span class="ex-meta-tag">⏱ {{ a.dureeMinutes }} min</span>
                          {% if a.caloriesBrulees %}<span class="ex-meta-tag">🔥 {{ a.caloriesBrulees }} kcal</span>{% endif %}
                          {% if a.nbSeries %}<span class="ex-meta-tag">✖ {{ a.nbSeries }}×{{ a.nbRepetitions ?: '?' }}</span>{% endif %}
                          {% if a.poids %}<span class="ex-meta-tag">⚖ {{ a.poids }} kg</span>{% endif %}
                        </div>
                        {% if a.notes %}<div style="font-size:11px;color:var(--tx-muted);margin-top:3px;font-style:italic">"{{ a.notes }}"</div>{% endif %}
                      </div>
                      <div class="ex-row-actions">
                        <button class="btn-edit-ex" title="Modifier"
                          onclick="openEdit({{ a.id }}, {{ a.dureeMinutes }}, {{ a.caloriesBrulees ?: 0 }}, {{ a.nbSeries ?: 0 }}, {{ a.nbRepetitions ?: 0 }}, {{ a.poids ?: 0 }}, '{{ a.notes|e('html_attr') }}')">✏️</button>
                        <button class="btn-del-ex" title="Supprimer"
                          onclick="event.stopPropagation();openDeleteModal({{ a.id }}, '{{ a.exercice.nomExercice|e('html_attr') }}')">🗑</button>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endif %}

        </div>
      </div>
    </div>

  </div>{# /main-col #}

  {# ── SIDE COLUMN ── #}
  <div class="side-col">

    {# STATS CARD #}
    <div class="stats-card fade">
      <div class="stats-header">
        <div class="stats-header-title">📈 Mes Statistiques</div>
      </div>
      <div class="stats-kpis">
        <div class="kpi purple">
          <div class="kpi-icon">🏆</div>
          <div class="kpi-val" id="sideSeances">{{ stats.sessions }}</div>
          <div class="kpi-lbl">Séances</div>
        </div>
        <div class="kpi green">
          <div class="kpi-icon">⏱️</div>
          <div class="kpi-val" id="sideMin">{{ stats.minutes }}</div>
          <div class="kpi-lbl">Minutes</div>
        </div>
        <div class="kpi orange">
          <div class="kpi-icon">🔥</div>
          <div class="kpi-val" id="sideCal">{{ stats.calories }}</div>
          <div class="kpi-lbl">Calories</div>
        </div>
        <div class="kpi blue">
          <div class="kpi-icon">💪</div>
          <div class="kpi-val" id="sideTotal">0</div>
          <div class="kpi-lbl">Exercices</div>
        </div>
      </div>
      <div class="chart-wrap">
        <canvas id="catChart"></canvas>
      </div>
      <div class="chart-legend" id="chartLegend">
        {# Filled by JS #}
      </div>
    </div>

    {# FAVORIS #}
    <div class="card fade d1">
      <div class="card-head">
        <div class="card-title">⭐ Mes Favoris</div>
        <span class="section-tag" id="favCount">0 fav</span>
      </div>
      <div class="card-body" style="padding:12px 16px">
        <div class="fav-grid" id="favList">
          <div class="fav-empty" id="favEmpty">
            <div class="fav-empty-icon">⭐</div>
            <div class="fav-empty-text">Aucun favori pour l'instant</div>
          </div>
        </div>
      </div>
    </div>

    {# AI COACH #}
    <div class="ai-card fade d2">
      <div class="ai-top">
        <div class="ai-avatar">🤖</div>
        <div>
          <div class="ai-name">Coach IA</div>
          <div class="ai-online"><span class="ai-dot"></span> En ligne</div>
        </div>
      </div>
      <div class="ai-msgs" id="aiMessages">
        <div class="ai-bubble bot">👋 Bonjour ! Posez-moi une question sur votre entraînement !</div>
        <div class="ai-thinking" id="aiThinking"><div class="think-dot"></div><div class="think-dot"></div><div class="think-dot"></div></div>
      </div>
      <div class="ai-input-row">
        <input class="ai-input" id="aiInput" placeholder="Conseil, exercice, nutrition..." onkeydown="if(event.key==='Enter')sendAI()">
        <button class="ai-send" onclick="sendAI()">➤</button>
      </div>
    </div>

  </div>{# /side-col #}
</div>{# /page #}

