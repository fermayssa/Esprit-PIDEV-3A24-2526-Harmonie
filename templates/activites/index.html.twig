{# ══ SCRIPTS ══ #}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-o9N1j7kG8bChx9cArCdZUrw2s2tRoSI6eR7X9tUuCPk=" crossorigin=""></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
// ══════════════════════════════════════════════════════
// CONFIG & STATE
// ══════════════════════════════════════════════════════
const API = {
  list:   '/activites/api/list',
  add:    '/activites/api/add',
  update: id => `/activites/api/update/${id}`,
  delete: id => `/activites/api/delete/${id}`,
  qr:     date => `/activites/qr/${date}`,         // Bundle 1 — QR Code
  bilanPdf: '/activites/bilan/pdf',                // Bundle 2 — KnpSnappy PDF
};

let selectedExercise = null;
let currentFilter    = 'all';
let editingId        = null;
let _deleteTargetId  = null;
let _catChart        = null;

// ══════════════════════════════════════════════════════
// INIT
// ══════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('dateSeance').value = new Date().toISOString().split('T')[0];

  // Category filter buttons
  document.querySelectorAll('.cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.cat-btn').forEach(b => {
        b.classList.remove('active','all','cardio','force','souplesse','endurance','perte');
      });
      btn.classList.add('active', btn.dataset.cls);
      currentFilter = btn.dataset.cat;
      filterExercises(currentFilter);
    });
  });

  document.getElementById('logForm').addEventListener('submit', handleLogSubmit);
  document.getElementById('editForm').addEventListener('submit', handleEditSubmit);

  // Avatar dropdown (from base template)
  const avatarBtn = document.getElementById('avatarBtn');
  const profileDropdown = document.getElementById('profileDropdown');
  if (avatarBtn && profileDropdown) {
    avatarBtn.addEventListener('click', e => { e.stopPropagation(); profileDropdown.classList.toggle('open'); });
    document.addEventListener('click', () => profileDropdown.classList.remove('open'));
  }

  // Close modals on overlay click
  document.querySelectorAll('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(overlay.id); });
  });

  initFavs();
  initChart();
  initActivityMap();
  updateSideTotal();
  animateCounters();
});

window.addEventListener('load', () => {
  if (activityMap) {
    activityMap.invalidateSize(true);
  } else {
    initActivityMap();
  }
});

// ══════════════════════════════════════════════════════════════════
// LEAFLET MAP — DÉPLACEMENT, PARCOURS ET PARCS SPORTIFS
// ══════════════════════════════════════════════════════
let activityMap = null;
let routePolyline = null;
let routeCoords = [];
let routeMarkers = [];
let parkMarkers = [];
let routeMode = false;
const DEFAULT_MAP_CENTER = [48.8566, 2.3522];
const DEFAULT_MAP_ZOOM = 13;

function initActivityMap() {
  const mapEl = document.getElementById('activityMap');
  if (!mapEl || typeof L === 'undefined') return;

  activityMap = L.map(mapEl, { zoomControl: false, scrollWheelZoom: false }).setView(DEFAULT_MAP_CENTER, DEFAULT_MAP_ZOOM);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors',
    maxZoom: 19,
  }).addTo(activityMap);

  routePolyline = L.polyline([], {
    color: '#5B8DEF',
    weight: 5,
    opacity: 0.85,
    dashArray: '8 6',
    lineJoin: 'round',
  }).addTo(activityMap);

  const zoomControl = L.control.zoom({ position: 'bottomright' });
  zoomControl.addTo(activityMap);

  activityMap.on('click', e => {
    if (!routeMode) return;
    addRoutePoint(e.latlng);
  });

  activityMap.whenReady(() => {
    activityMap.invalidateSize(true);
    activityMap.setView(DEFAULT_MAP_CENTER, DEFAULT_MAP_ZOOM);
  });

  setTimeout(() => {
    if (activityMap) {
      activityMap.invalidateSize(true);
      activityMap.setView(DEFAULT_MAP_CENTER, DEFAULT_MAP_ZOOM);
    }
  }, 600);

  window.addEventListener('resize', () => {
    if (activityMap) activityMap.invalidateSize(true);
  });

  requestAnimationFrame(() => {
    if (activityMap) {
      activityMap.invalidateSize(true);
      activityMap.setView(DEFAULT_MAP_CENTER, DEFAULT_MAP_ZOOM);
    }
  });

  setTimeout(() => {
    if (activityMap) {
      activityMap.invalidateSize(true);
      activityMap.setView(DEFAULT_MAP_CENTER, DEFAULT_MAP_ZOOM);
    }
  }, 1200);

  locateUser(true);
}

function showMapError(message) {
  const mapEl = document.getElementById('activityMap');
  if (!mapEl) return;
  mapEl.innerHTML = `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:20px;color:#5B5B7B;background:#eef2ff;border-radius:20px;text-align:center;">
    <div><strong>Carte non chargée</strong><div style="margin-top:8px;font-size:13px;">${message}</div></div>
  </div>`;
}

function locateUser(silent = false) {
  if (!navigator.geolocation) {
    if (!silent) showToast('error', '🌍 Géolocalisation non supportée par votre navigateur.');
    return;
  }

  const status = document.getElementById('parkStatus');
  if (status) status.textContent = '⏳ Recherche de votre position…';

  navigator.geolocation.getCurrentPosition(position => {
    const { latitude, longitude } = position.coords;
    if (activityMap) {
      activityMap.setView([latitude, longitude], DEFAULT_MAP_ZOOM);
      L.circle([latitude, longitude], { radius: 80, color: '#5B8DEF', fillColor: 'rgba(91, 138, 239, .12)', fillOpacity: 0.6 }).addTo(activityMap);
      if (status) status.textContent = '📍 Vous êtes localisé. Cliquez sur 🏟️ pour afficher les parcs de sport.';
    }
  }, error => {
    if (status) status.textContent = '⚠ Impossible de localiser. Utilisez la carte manuellement.';
    if (!silent) showToast('error', '⚠ Permission de localisation refusée ou indisponible.');
  }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 });
}

function toggleRouteMode() {
  routeMode = !routeMode;
  const btn = document.getElementById('routeToggleBtn');
  if (!btn) return;
  btn.classList.toggle('active', routeMode);
  btn.textContent = routeMode ? '🛑 Terminer' : '✍️';
  const info = document.getElementById('routeInfo');
  if (routeMode) {
    if (info) info.innerHTML = '<strong>Parcours :</strong> Cliquez sur la carte pour ajouter des points.';
    showToast('info', 'Cliquez sur la carte pour tracer votre parcours.');
  } else {
    updateRouteMetrics();
    showToast('success', 'Parcours enregistré localement.');
  }
}

function addRoutePoint(latlng) {
  if (!activityMap) return;
  routeCoords.push([latlng.lat, latlng.lng]);
  const marker = L.circleMarker(latlng, {
    radius: 8,
    fillColor: '#5B8DEF',
    color: '#fff',
    weight: 2,
    fillOpacity: 1,
  }).addTo(activityMap);
  routeMarkers.push(marker);
  routePolyline.setLatLngs(routeCoords);
  updateRouteMetrics();
}

function resetRoute() {
  routeCoords = [];
  routeMarkers.forEach(m => activityMap && activityMap.removeLayer(m));
  routeMarkers = [];
  if (routePolyline) routePolyline.setLatLngs([]);
  const info = document.getElementById('routeInfo');
  if (info) info.innerHTML = '<strong>Parcours :</strong> Aucun tracé';
  showToast('info', 'Le parcours a été réinitialisé.');
}

function updateRouteMetrics() {
  if (!activityMap || routeCoords.length < 2) {
    const info = document.getElementById('routeInfo');
    if (info) info.innerHTML = '<strong>Parcours :</strong> Aucun tracé';
    return;
  }

  let distance = 0;
  for (let i = 1; i < routeCoords.length; i++) {
    distance += activityMap.distance(routeCoords[i - 1], routeCoords[i]);
  }

  const info = document.getElementById('routeInfo');
  if (info) info.innerHTML = `<strong>Parcours :</strong> ${(distance / 1000).toFixed(2)} km · ${routeCoords.length} point${routeCoords.length > 1 ? 's' : ''}`;
}

async function searchParks() {
  if (!activityMap) return;
  const center = activityMap.getCenter();
  const status = document.getElementById('parkStatus');
  if (status) status.textContent = '⏳ Recherche des parcs sportifs aux alentours…';
  clearParks();
  try {
    const query = `[out:json][timeout:25];(node["leisure"="park"](around:3000,${center.lat},${center.lng});way["leisure"="park"](around:3000,${center.lat},${center.lng});relation["leisure"="park"](around:3000,${center.lat},${center.lng});node["sport"](around:3000,${center.lat},${center.lng});way["sport"](around:3000,${center.lat},${center.lng});relation["sport"](around:3000,${center.lat},${center.lng}););out center;`;
    const response = await fetch('https://overpass-api.de/api/interpreter', {
      method: 'POST',
      body: query,
      headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
    });
    const result = await response.json();
    addParkMarkers(result.elements || []);
  } catch (err) {
    if (status) status.textContent = '⚠ Impossible de charger les parcs.';
    showToast('error', 'Erreur lors de la recherche des parcs sportifs.');
  }
}

function clearParks() {
  parkMarkers.forEach(m => activityMap && activityMap.removeLayer(m));
  parkMarkers = [];
  const status = document.getElementById('parkStatus');
  if (status) status.textContent = '<strong>Parcs :</strong> Aucun parc affiché.';
}

function addParkMarkers(elements) {
  if (!activityMap) return;
  const unique = new Map();
  elements.forEach(el => {
    const center = el.type === 'node' ? { lat: el.lat, lon: el.lon } : (el.center || {});
    if (!center.lat || !center.lon) return;
    const id = `${el.type}-${el.id}`;
    if (unique.has(id)) return;
    unique.set(id, true);

    const label = el.tags?.name || (el.tags?.sport ? `Parc ${el.tags.sport}` : 'Parc sportif');
    const marker = L.marker([center.lat, center.lon], {
      title: label,
      alt: label,
    }).addTo(activityMap);
    marker.bindPopup(`<strong>${label}</strong><br>${el.tags?.leisure || el.tags?.sport || ''}`);
    parkMarkers.push(marker);
  });

  const count = parkMarkers.length;
  const status = document.getElementById('parkStatus');
  if (status) status.innerHTML = `<strong>Parcs :</strong> ${count} lieu${count !== 1 ? 'x' : ''} trouvé${count !== 1 ? 's' : ''}.`;
  if (count === 0) showToast('info', 'Aucun parc sportif trouvé autour de cette zone.');
}

// ═════════════════════════════════════════════════════=
// ANIMATED COUNTERS (hero stats on load)
// ═════════════════════════════════════════════════════=
function animateCounters() {
  ['statSeances','statMinutes','statCalories','sideSeances','sideMin','sideCal'].forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    const target = parseInt(el.textContent) || 0;
    if (target === 0) return;
    let start = 0;
    const step = Math.ceil(target / 30);
    const interval = setInterval(() => {
      start = Math.min(start + step, target);
      el.textContent = start;
      if (start >= target) clearInterval(interval);
    }, 30);
  });
}

// ══════════════════════════════════════════════════════
// CHART — category donut
// ══════════════════════════════════════════════════════
function initChart() {
  // Compute category counts from rendered DOM
  const cats = { Cardio:0, Force:0, Souplesse:0, Endurance:0, Perte:0 };
  document.querySelectorAll('.ex-row').forEach(row => {
    const dot = row.querySelector('.ex-row-dot');
    if (!dot) return;
    if (dot.classList.contains('cardio'))   cats.Cardio++;
    else if (dot.classList.contains('force'))    cats.Force++;
    else if (dot.classList.contains('souplesse')) cats.Souplesse++;
    else if (dot.classList.contains('endurance')) cats.Endurance++;
    else if (dot.classList.contains('perte'))     cats.Perte++;
  });

  const colors  = ['#FF6B6B','#5B8DEF','#43D39E','#F7B731','#FD7272'];
  const labels  = Object.keys(cats);
  const data    = Object.values(cats);
  const total   = data.reduce((a,b)=>a+b,0) || 1;

  const ctx = document.getElementById('catChart').getContext('2d');
  _catChart = new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels,
      datasets: [{
        data,
        backgroundColor: colors,
        borderColor: '#fff',
        borderWidth: 3,
        hoverOffset: 8,
      }]
    },
    options: {
      responsive:true,
      cutout:'68%',
      plugins:{
        legend:{display:false},
        tooltip:{
          callbacks:{
            label: ctx => ` ${ctx.label}: ${ctx.raw} exercice${ctx.raw!==1?'s':''}`
          }
        }
      }
    }
  });

  // Custom legend
  const legend = document.getElementById('chartLegend');
  legend.innerHTML = '';
  labels.forEach((lbl, i) => {
    const pct = Math.round(data[i] / total * 100);
    const item = document.createElement('div');
    item.className = 'legend-item';
    item.innerHTML = `
      <div class="legend-dot-label">
        <div class="legend-dot" style="background:${colors[i]}"></div>
        <span class="legend-name">${lbl}</span>
      </div>
      <div class="legend-bar-wrap"><div class="legend-bar" style="width:${pct}%;background:${colors[i]}"></div></div>
      <span class="legend-count">${data[i]}</span>`;
    legend.appendChild(item);
  });
}

function refreshChart() {
  // Re-fetch from API and rebuild chart
  fetch(API.list)
    .then(r => r.json())
    .then(data => {
      const cats = { Cardio:0, Force:0, Souplesse:0, Endurance:0, Perte:0 };
      (data.sessions || []).forEach(s => {
        (s.exercises || []).forEach(e => {
          const t = (e.exercice_type || '').toLowerCase();
          if ('cardio' in t || t.includes('cardio')) cats.Cardio++;
          else if (t.includes('force'))    cats.Force++;
          else if (t.includes('souplesse')) cats.Souplesse++;
          else if (t.includes('endurance')) cats.Endurance++;
          else if (t.includes('perte'))     cats.Perte++;
        });
      });
      if (_catChart) {
        _catChart.data.datasets[0].data = Object.values(cats);
        _catChart.update();
      }
    })
    .catch(() => {});
}

