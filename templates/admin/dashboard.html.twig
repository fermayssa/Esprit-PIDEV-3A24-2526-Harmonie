{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de bord — Admin{% endblock %}

{% block body %}
<div class="admin-topbar">
    <h1 class="admin-page-title">Tableau de bord</h1>
</div>

{% if countDemandesEnAttente > 0 %}
<div class="admin-alert admin-alert--warn">
    <strong>{{ countDemandesEnAttente }}</strong> demande(s) de salle en attente de traitement.
    <a href="{{ path('admin_demande_index', { statut: 'EN_ATTENTE' }) }}">Voir les demandes</a>
</div>
{% endif %}

<div class="admin-stats">
    <div class="admin-stat-card">
        <strong>{{ countEvenements }}</strong>
        <span>Événements</span>
    </div>
    <div class="admin-stat-card">
        <strong>{{ countTaches }}</strong>
        <span>Tâches</span>
    </div>
    <div class="admin-stat-card">
        <strong>{{ countSalles }}</strong>
        <span>Salles</span>
    </div>
    <div class="admin-stat-card">
        <strong>{{ countDemandesEnAttente }}</strong>
        <span>Demandes en attente</span>
    </div>
</div>

<section class="admin-dash-section">
    <h2 class="admin-dash-section__title">Derniers événements</h2>
    <div class="admin-cards-grid">
        {% for e in recentEvenements %}
            <article class="admin-module-card admin-module-card--accent-ev">
                <h3 class="admin-module-card__title" style="margin:0 0 8px;">{{ e.titre ?? 'Sans titre' }}</h3>
                <p class="admin-module-card__meta">📅 {% if e.dateDebut %}{{ e.dateDebut|date('d/m/Y H:i') }}{% else %}—{% endif %}</p>
                <p class="admin-module-card__meta">👤 {{ e.proprietaire ? (e.proprietaire.userPrenom ~ ' ' ~ e.proprietaire.userNom) : '—' }}</p>
                <div class="admin-module-card__footer">
                    <a href="{{ path('admin_evenement_show', { id: e.id }) }}" class="admin-btn admin-btn-ghost">Voir</a>
                </div>
            </article>
        {% else %}
            <p class="admin-empty-hint" style="grid-column: 1 / -1;">Aucun événement.</p>
        {% endfor %}
    </div>
</section>

<section class="admin-dash-section">
    <h2 class="admin-dash-section__title">Demandes en attente</h2>
    <div class="admin-cards-grid">
        {% for d in demandesEnAttente %}
            <article class="admin-module-card admin-module-card--accent-demande"
                     data-admin-demande-card
                     data-csrf="{{ csrf_token('admin_demande_action' ~ d.id) }}"
                     data-url-accepter="{{ path('admin_demande_accepter', { id: d.id }) }}"
                     data-url-refuser="{{ path('admin_demande_refuser', { id: d.id }) }}">
                <div class="admin-module-card__head">
                    <span class="admin-badge admin-badge--wait admin-badge--pulse js-demande-badge">En attente</span>
                </div>
                <p class="admin-module-card__meta">👤 {{ d.utilisateur ? (d.utilisateur.userPrenom ~ ' ' ~ d.utilisateur.userNom) : '—' }}</p>
                <p class="admin-module-card__meta">🗓️ {{ d.evenement ? (d.evenement.titre ?? 'Sans titre') : '—' }}</p>
                <p class="admin-module-card__meta">🏢 {{ d.salle ? d.salle.nom : '—' }}</p>
                <div class="admin-demande-actions js-demande-actions">
                    <textarea class="admin-input js-demande-refuse-comment" rows="2" placeholder="Motif du refus (optionnel)" style="width:100%;max-width:100%;resize:vertical;"></textarea>
                    <div class="admin-demande-actions__row">
                        <button type="button" class="admin-btn admin-btn-accept js-demande-accepter">✅ Accepter</button>
                        <button type="button" class="admin-btn admin-btn-refuse js-demande-refuser">❌ Refuser</button>
                    </div>
                </div>
                <p class="admin-module-card__meta js-demande-admin-note" hidden></p>
            </article>
        {% else %}
            <p class="admin-empty-hint" style="grid-column: 1 / -1;">Aucune demande en attente.</p>
        {% endfor %}
    </div>
    <p style="margin-top:16px;">
        <a href="{{ path('admin_demande_index', { statut: 'EN_ATTENTE' }) }}" class="admin-btn admin-btn-ghost">Voir toutes les demandes en attente</a>
    </p>
</section>

<section class="admin-dash-section">
    <h2 class="admin-dash-section__title">Tâches récentes</h2>
    <div class="admin-cards-grid">
        {% for t in recentTaches %}
            <article class="admin-module-card admin-module-card--accent-tache">
                <h3 class="admin-module-card__title" style="margin:0 0 8px;">{{ t.nom }}</h3>
                <p class="admin-module-card__meta">📅 {{ t.deadline ? t.deadline|date('d/m/Y') : '—' }}</p>
                <p class="admin-module-card__meta">📝 {% if t.notes %}{{ t.notes|slice(0, 60) }}{% if t.notes|length > 60 %}…{% endif %}{% else %}—{% endif %}</p>
                <div class="admin-module-card__footer">
                    <a href="{{ path('admin_tache_show', { id: t.id }) }}" class="admin-btn admin-btn-ghost">Voir</a>
                </div>
            </article>
        {% else %}
            <p class="admin-empty-hint" style="grid-column: 1 / -1;">Aucune tâche.</p>
        {% endfor %}
    </div>
</section>
{% endblock %}
