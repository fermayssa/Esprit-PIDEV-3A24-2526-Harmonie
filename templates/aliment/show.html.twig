{% extends 'base.html.twig' %}

{% block title %}Aliment{% endblock %}

{% block content %}
    <h1>Aliment</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>IdAliment</th>
                <td>{{ aliment.idAliment }}</td>
            </tr>
            <tr>
                <th>NomAliment</th>
                <td>{{ aliment.nomAliment }}</td>
            </tr>
            <tr>
                <th>CaloriesPour100g</th>
                <td>{{ aliment.caloriesPour100g }}</td>
            </tr>
            <tr>
                <th>Proteines</th>
                <td>{{ aliment.proteines }}</td>
            </tr>
            <tr>
                <th>Glucides</th>
                <td>{{ aliment.glucides }}</td>
            </tr>
            <tr>
                <th>Lipides</th>
                <td>{{ aliment.lipides }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_aliment_index') }}">back to list</a>

    <a href="{{ path('app_aliment_edit', {'idAliment': aliment.idAliment}) }}">edit</a>

    {{ include('aliment/_delete_form.html.twig') }}
{% endblock %}
