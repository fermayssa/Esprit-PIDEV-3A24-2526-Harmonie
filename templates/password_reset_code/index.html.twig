{% extends 'base.html.twig' %}

{% block title %}PasswordResetCode index{% endblock %}

{% block content %}
    <h1>PasswordResetCode index</h1>

    <table class="table table-bordered table-hover w-100">
        <thead>
            <tr>
                <th>Id</th>
                <th>Email</th>
                <th>Code</th>
                <th>ExpiresAt</th>
                <th>Used</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for password_reset_code in password_reset_codes %}
            <tr>
                <td>{{ password_reset_code.id }}</td>
                <td>{{ password_reset_code.email }}</td>
                <td>{{ password_reset_code.code }}</td>
                <td>{{ password_reset_code.expiresAt ? password_reset_code.expiresAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ password_reset_code.used ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_password_reset_code_show', {'id': password_reset_code.id}) }}">show</a>
                    <a href="{{ path('app_password_reset_code_edit', {'id': password_reset_code.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_password_reset_code_new') }}">Create new</a>
{% endblock %}
