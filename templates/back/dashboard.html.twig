{% extends 'back/base_back.html.twig' %}
{% block title %}Dashboard — Back Harmony{% endblock %}
{% block topbar_icon %}🏠{% endblock %}
{% block topbar_title %}Accueil Back{% endblock %}

{% block body %}
<div class="page-hd">
  <span style="font-size:20px">🏠</span>
  <h1>Tableau de bord</h1>
</div>

<div class="stats-row col3">
  <a href="{{ path('back_categories') }}" style="text-decoration:none">
    <div class="stat-card" style="cursor:pointer;transition:box-shadow .15s" onmouseover="this.style.boxShadow='0 6px 24px rgba(91,79,207,.12)'" onmouseout="this.style.boxShadow='none'">
      <div class="stat-icon purple">🗂️</div>
      <div>
        <div class="stat-val">{{ nb_categories }}</div>
        <div class="stat-lbl">Catégories Forum</div>
      </div>
    </div>
  </a>
  <a href="{{ path('back_posts') }}" style="text-decoration:none">
    <div class="stat-card" style="cursor:pointer;transition:box-shadow .15s" onmouseover="this.style.boxShadow='0 6px 24px rgba(34,197,94,.12)'" onmouseout="this.style.boxShadow='none'">
      <div class="stat-icon green">📝</div>
      <div>
        <div class="stat-val">{{ nb_posts }}</div>
        <div class="stat-lbl">Posts publiés</div>
      </div>
    </div>
  </a>
  <a href="{{ path('back_commentaires') }}" style="text-decoration:none">
    <div class="stat-card" style="cursor:pointer;transition:box-shadow .15s" onmouseover="this.style.boxShadow='0 6px 24px rgba(245,158,11,.12)'" onmouseout="this.style.boxShadow='none'">
      <div class="stat-icon amber">💬</div>
      <div>
        <div class="stat-val">{{ nb_commentaires }}</div>
        <div class="stat-lbl">Commentaires</div>
      </div>
    </div>
  </a>
</div>

<div class="panel">
  <div class="panel-head">
    <h3>🚀 Accès rapides</h3>
  </div>
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border)">
    {% set quick = [
      {icon:'🗂️', label:'Gérer les catégories', route:'back_categories', desc:'Créer, modifier, supprimer'},
      {icon:'📝', label:'Gérer les posts',       route:'back_posts',      desc:'Modérer les publications'},
      {icon:'💬', label:'Gérer les commentaires',route:'back_commentaires',desc:'Modérer les échanges'},
    ] %}
    {% for item in quick %}
    <a href="{{ path(item.route) }}" style="display:flex;align-items:center;gap:14px;padding:20px 24px;background:white;text-decoration:none;transition:background .15s" onmouseover="this.style.background='#F5F4FC'" onmouseout="this.style.background='white'">
      <span style="font-size:28px">{{ item.icon }}</span>
      <div>
        <div style="font-family:var(--font-head);font-size:14px;font-weight:700;color:var(--text)">{{ item.label }}</div>
        <div style="font-size:12px;color:var(--text-muted);margin-top:2px">{{ item.desc }}</div>
      </div>
      <span style="margin-left:auto;color:var(--purple-soft);font-size:18px">→</span>
    </a>
    {% endfor %}
  </div>
</div>
{% endblock %}
