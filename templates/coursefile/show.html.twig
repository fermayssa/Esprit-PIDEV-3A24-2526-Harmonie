{% extends 'base.html.twig' %}

{% block title %}Coursefile{% endblock %}

{% block content %}
    <h1>Coursefile</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ coursefile.id }}</td>
            </tr>
            <tr>
                <th>Originalname</th>
                <td>{{ coursefile.originalname }}</td>
            </tr>
            <tr>
                <th>Mimetype</th>
                <td>{{ coursefile.mimetype }}</td>
            </tr>
            <tr>
                <th>Sizebytes</th>
                <td>{{ coursefile.sizebytes }}</td>
            </tr>
            <tr>
                <th>Filedata</th>
                <td><em>Binaire (non affiché)</em> — taille {{ coursefile.sizebytes }} octets</td>
            </tr>
            <tr>
                <th>UploadedAt</th>
                <td>{{ coursefile.uploadedAt ? coursefile.uploadedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_coursefile_index') }}">back to list</a>

    <a href="{{ path('app_coursefile_edit', {'id': coursefile.id}) }}">edit</a>

    {{ include('coursefile/_delete_form.html.twig') }}
{% endblock %}
