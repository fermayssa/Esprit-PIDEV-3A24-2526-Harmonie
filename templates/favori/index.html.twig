{% extends 'base.html.twig' %}

{% block title %}Favori index{% endblock %}

{% block content %}
    <h1>Favori index</h1>

    <table class="table table-bordered table-hover w-100">
        <thead>
            <tr>
                <th>IdFavori</th>
                <th>DateAjout</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for favori in favoris %}
            <tr>
                <td>{{ favori.idFavori }}</td>
                <td>{{ favori.dateAjout ? favori.dateAjout|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_favori_show', {'idFavori': favori.idFavori}) }}">show</a>
                    <a href="{{ path('app_favori_edit', {'idFavori': favori.idFavori}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_favori_new') }}">Create new</a>
{% endblock %}
