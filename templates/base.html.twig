<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% block body %}{% endblock %}
        <!-- ══════════════════════════════════════════════════════════════
         DEV MOCK USER PICKER  —  remove before production
         Paste at the bottom of base.html.twig, just before </body>
         ══════════════════════════════════════════════════════════════ -->
        <div id="mockUserWidget" style="
    position:fixed; bottom:16px; right:16px; z-index:9999;
    font-family:Inter,sans-serif; font-size:13px;">

            <button id="mockUserToggle" style="
      background:#01696f; color:#fff; border:none; border-radius:999px;
      padding:7px 16px; cursor:pointer; box-shadow:0 2px 8px rgba(0,0,0,.3);
      display:flex; align-items:center; gap:6px; font-size:13px; font-weight:500;">
                👤 <span id="mockUserLabel">Pick user…</span>
            </button>

            <div id="mockUserPanel" style="
      display:none; position:absolute; bottom:calc(100% + 8px); right:0;
      background:#1c1b19; border:1px solid #393836; border-radius:14px;
      padding:16px; min-width:300px; box-shadow:0 8px 32px rgba(0,0,0,.5);">

                <p style="color:#5a5957; margin:0 0 10px; font-size:11px;
              text-transform:uppercase; letter-spacing:.07em;">
                    🛠 Dev — Switch user
                </p>

                <input id="mockUserSearch" type="text" placeholder="Search by name or email…"
                       autocomplete="off" style="
        width:100%; box-sizing:border-box; background:#22211f;
        border:1px solid #393836; border-radius:8px;
        padding:7px 10px; color:#cdccca; font-size:13px; margin-bottom:10px;
        outline:none;">

                <div id="mockUserList" style="
        max-height:240px; overflow-y:auto;
        display:flex; flex-direction:column; gap:3px;"></div>

                <button id="mockUserClear" style="
        margin-top:12px; width:100%; background:transparent;
        border:1px solid #393836; border-radius:8px;
        color:#797876; padding:6px; cursor:pointer; font-size:12px;">
                    ✕ Clear (no user)
                </button>
            </div>
        </div>

        <script>
            (function(){
                let allUsers = [], activeId = null;
                const toggle   = document.getElementById('mockUserToggle');
                const panel    = document.getElementById('mockUserPanel');
                const label    = document.getElementById('mockUserLabel');
                const search   = document.getElementById('mockUserSearch');
                const listEl   = document.getElementById('mockUserList');
                const clearBtn = document.getElementById('mockUserClear');

                // Load current mock user on page load
                fetch('/dev/mock-user/current').then(r => r.json()).then(d => {
                    if (d.user) { activeId = d.user.id; label.textContent = d.user.firstname + ' ' + d.user.lastname; }
                });

                toggle.addEventListener('click', e => {
                    e.stopPropagation();
                    const opening = panel.style.display === 'none';
                    panel.style.display = opening ? 'block' : 'none';
                    if (opening) {
                        if (!allUsers.length) loadUsers(); else renderList(allUsers);
                        setTimeout(() => search.focus(), 60);
                    }
                });
                document.addEventListener('click', () => panel.style.display = 'none');
                panel.addEventListener('click', e => e.stopPropagation());
                search.addEventListener('keydown', e => e.stopPropagation());

                function loadUsers() {
                    listEl.innerHTML = '<p style="color:#5a5957;font-size:12px;text-align:center;padding:12px 0;">Loading…</p>';
                    fetch('/dev/mock-user/list').then(r => r.json()).then(data => {
                        allUsers = data;
                        renderList(allUsers);
                    });
                }

                function roleColor(role) {
                    const map = { ADMIN: '#a86fdf', COACH: '#4f98a3', ETUDIANT: '#6daa45', USER: '#6daa45' };
                    return map[(role || '').toUpperCase()] || '#797876';
                }

                function renderList(items) {
                    listEl.innerHTML = '';
                    if (!items.length) {
                        listEl.innerHTML = '<p style="color:#5a5957;font-size:12px;text-align:center;padding:12px 0;">No users found</p>';
                        return;
                    }
                    items.forEach(u => {
                        const isActive = u.id == activeId;
                        const btn = document.createElement('button');
                        btn.style.cssText = `text-align:left; background:${isActive ? '#1a3335' : 'transparent'};
        border:1px solid ${isActive ? '#4f98a3' : 'transparent'};
        border-radius:8px; padding:8px 10px; color:#cdccca;
        cursor:pointer; font-size:13px; width:100%; transition:background .15s;`;
                        btn.innerHTML = `
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
          <strong style="font-size:13px;">${u.firstname} ${u.lastname}</strong>
          <span style="font-size:10px;color:${roleColor(u.role)};font-weight:600;
                       background:${roleColor(u.role)}22;border-radius:4px;padding:1px 6px;">
            ${u.role || ''}
          </span>
        </div>
        <div style="color:#797876;font-size:11px;margin-top:1px;">${u.email} · #${u.id}</div>`;
                        btn.addEventListener('mouseenter', () => { if (!isActive) btn.style.background = '#22211f'; });
                        btn.addEventListener('mouseleave', () => { if (!isActive) btn.style.background = 'transparent'; });
                        btn.addEventListener('click', () => selectUser(u));
                        listEl.appendChild(btn);
                    });
                }

                search.addEventListener('input', () => {
                    const q = search.value.toLowerCase();
                    renderList(allUsers.filter(u =>
                        (u.firstname + ' ' + u.lastname + ' ' + u.email).toLowerCase().includes(q)
                    ));
                });

                function selectUser(u) {
                    const fd = new FormData(); fd.append('userId', u.id);
                    fetch('/dev/mock-user/set', { method: 'POST', body: fd })
                        .then(r => r.json()).then(d => {
                        if (!d.ok) return;
                        activeId = u.id;
                        label.textContent = u.firstname + ' ' + u.lastname;
                        panel.style.display = 'none';
                        location.reload();
                    });
                }

                clearBtn.addEventListener('click', () => {
                    const fd = new FormData(); fd.append('userId', 0);
                    fetch('/dev/mock-user/set', { method: 'POST', body: fd }).then(() => {
                        activeId = null; label.textContent = 'Pick user…';
                        panel.style.display = 'none';
                        location.reload();
                    });
                });
            })();
        </script>
        <!-- ══ END DEV MOCK USER PICKER ══ -->
    </body>
</html>
