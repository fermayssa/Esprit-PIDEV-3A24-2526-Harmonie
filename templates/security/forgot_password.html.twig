{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié — Harmony{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --ink:       #0c0c11;
    --panel:     #13131d;
    --card:      #1a1a28;
    --gold:      #c9a96e;
    --gold-dim:  rgba(201,169,110,.12);
    --gold-ring: rgba(201,169,110,.28);
    --white:     #ffffff;
    --glass:     rgba(255,255,255,.055);
    --line:      rgba(255,255,255,.08);
    --muted:     rgba(255,255,255,.40);
    --green:     #6ee7b7;
    --red:       #e07070;
    --font-head: 'Cormorant Garamond', serif;
    --font-body: 'DM Sans', sans-serif;
}

html, body {
    min-height: 100vh;
    font-family: var(--font-body);
    background: var(--ink);
    color: var(--white);
    display: grid;
    place-items: center;
    padding: 40px 20px;
}

/* déco de fond */
body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
        radial-gradient(ellipse 55% 55% at 8% 92%, rgba(201,169,110,.07) 0%, transparent 60%),
        radial-gradient(ellipse 38% 38% at 92% 8%,  rgba(106,90,205,.05) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
}

.wrap {
    width: 100%;
    max-width: 490px;
    position: relative;
    z-index: 1;
    animation: fadeUp .5s cubic-bezier(.16,1,.3,1) both;
}
@keyframes fadeUp { from { opacity:0; transform:translateY(22px); } to { opacity:1; transform:none; } }

/* ── Lien retour ── */
.back-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
    text-decoration: none;
    font-size: 13px;
    margin-bottom: 26px;
    transition: color .15s;
}
.back-link:hover { color: var(--gold); }

/* ── Carte ── */
.card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 48px 44px;
    box-shadow: 0 32px 80px rgba(0,0,0,.55);
}

/* ── Indicateur d'étapes ── */
.steps {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 36px;
}
.step-dot {
    width: 32px; height: 32px;
    border-radius: 50%;
    display: grid; place-items: center;
    font-size: 12px; font-weight: 700;
    flex-shrink: 0;
    transition: .3s;
}
.step-dot.active  { background: var(--gold); color: var(--ink); box-shadow: 0 4px 16px var(--gold-dim); }
.step-dot.done    { background: rgba(110,231,183,.18); color: var(--green); border: 1px solid rgba(110,231,183,.3); }
.step-dot.idle    { background: var(--glass); color: var(--muted); border: 1px solid var(--line); }
.step-line        { flex: 1; max-width: 56px; height: 1px; background: var(--line); }
.step-line.done   { background: rgba(110,231,183,.3); }

/* ── Logo ── */
.card-logo {
    display: flex; align-items: center; gap: 10px;
    justify-content: center; margin-bottom: 22px;
}
.card-logo img   { width: 28px; height: 28px; border-radius: 7px; }
.card-logo span  { font-family: var(--font-head); font-size: 17px; font-weight: 600; color: var(--gold); }

/* ── Titres ── */
.card-title {
    font-family: var(--font-head);
    font-size: 28px; font-weight: 700;
    color: var(--white);
    text-align: center;
    margin-bottom: 8px;
    letter-spacing: -.3px;
}
.card-sub {
    text-align: center;
    font-size: 13.5px;
    color: var(--muted);
    margin-bottom: 30px;
    line-height: 1.65;
    font-weight: 300;
}
.card-sub strong { color: var(--gold); font-weight: 600; }

/* ── Alertes ── */
.alert {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 11px 15px; border-radius: 10px;
    font-size: 13px; margin-bottom: 18px; line-height: 1.5;
}
.alert-error   { background: rgba(224,112,112,.1);  border: 1px solid rgba(224,112,112,.25); color: #ffb3b3; }
.alert-info    { background: var(--gold-dim);        border: 1px solid var(--gold-ring);       color: rgba(201,169,110,.9); }

/* ── Champs ── */
.form-group { margin-bottom: 20px; }
.form-group label {
    display: block;
    font-size: 11px; font-weight: 600;
    letter-spacing: 1px; text-transform: uppercase;
    color: var(--muted); margin-bottom: 8px;
}
.input-wrap { position: relative; }
.input-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-size: 15px; opacity: .35; pointer-events: none; }
.form-group input {
    width: 100%;
    padding: 13px 14px 13px 42px;
    background: var(--glass);
    border: 1px solid var(--line);
    border-radius: 11px;
    font-family: var(--font-body);
    font-size: 14px; color: var(--white);
    outline: none;
    transition: border-color .2s, background .2s, box-shadow .2s;
}
.form-group input::placeholder { color: rgba(255,255,255,.18); }
.form-group input:focus {
    border-color: var(--gold);
    background: rgba(201,169,110,.05);
    box-shadow: 0 0 0 3px var(--gold-dim);
}

/* ── Bloc QR ── */
.qr-block {
    background: var(--gold-dim);
    border: 1px solid var(--gold-ring);
    border-radius: 16px;
    padding: 24px;
    text-align: center;
    margin-bottom: 26px;
}
.qr-block h3 {
    font-family: var(--font-head);
    font-size: 18px; font-weight: 600;
    color: var(--gold); margin-bottom: 8px;
}
.qr-block p { font-size: 13px; color: var(--muted); line-height: 1.6; margin-bottom: 16px; }
.qr-canvas-wrap {
    display: inline-flex;
    background: white;
    border-radius: 12px;
    padding: 12px;
    margin-bottom: 16px;
}
/* liste des étapes */
.qr-steps { list-style: none; text-align: left; margin-top: 14px; }
.qr-steps li {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 7px 0;
    border-bottom: 1px solid rgba(255,255,255,.04);
    font-size: 13px; color: var(--muted);
}
.qr-steps li:last-child { border: none; }
.step-num {
    width: 22px; height: 22px; border-radius: 50%;
    background: rgba(201,169,110,.18); color: var(--gold);
    font-size: 11px; font-weight: 700;
    display: grid; place-items: center;
    flex-shrink: 0; margin-top: 1px;
}
.qr-steps strong { color: rgba(255,255,255,.75); }

/* ── Saisie TOTP ── */
.totp-wrap { margin-bottom: 24px; }
.totp-wrap label {
    display: block;
    font-size: 11px; font-weight: 600;
    letter-spacing: 1px; text-transform: uppercase;
    color: var(--muted); margin-bottom: 8px;
}
.totp-input {
    width: 100%;
    padding: 16px 14px;
    background: var(--glass);
    border: 1px solid var(--line);
    border-radius: 11px;
    font-family: var(--font-head);
    font-size: 34px; font-weight: 700;
    color: var(--gold);
    text-align: center;
    letter-spacing: 16px;
    outline: none;
    transition: border-color .2s, box-shadow .2s;
}
.totp-input::placeholder { color: rgba(201,169,110,.2); font-size: 26px; letter-spacing: 10px; }
.totp-input:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px var(--gold-dim);
}

/* Timer TOTP */
.totp-timer {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    margin-top: 10px; font-size: 12px; color: var(--muted);
}
.timer-svg { transform: rotate(-90deg); }
.timer-bg   { fill: none; stroke: rgba(255,255,255,.07); stroke-width: 2.5; }
.timer-prog { fill: none; stroke: var(--gold); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 50.27; transition: stroke-dashoffset 1s linear; }

/* ── Indicateur de force mdp ── */
.pwd-strength { margin-top: 10px; }
.pwd-bars     { display: flex; gap: 4px; margin-bottom: 6px; }
.pwd-bar      { height: 3px; flex: 1; border-radius: 3px; background: rgba(255,255,255,.08); transition: background .3s; }
.strength-lbl { font-size: 12px; font-weight: 600; min-height: 16px; margin-bottom: 8px; transition: color .2s; }
.pwd-rules    { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
.pwd-rule { font-size: 11px; color: var(--muted); display: flex; align-items: center; gap: 5px; transition: color .2s; }
.pwd-rule.ok { color: var(--green); }
.pwd-rule::before { content: '○'; font-size: 9px; }
.pwd-rule.ok::before { content: '✓'; }

/* ── Bouton ── */
.btn-submit {
    width: 100%;
    padding: 14px;
    background: var(--gold);
    color: var(--ink);
    border: none;
    border-radius: 11px;
    font-family: var(--font-body);
    font-size: 15px; font-weight: 600;
    cursor: pointer; letter-spacing: .3px;
    box-shadow: 0 6px 24px var(--gold-dim);
    transition: opacity .15s, transform .1s;
}
.btn-submit:hover { opacity: .9; transform: translateY(-1px); }

.match-error {
    color: #ffb3b3;
    font-size: 12px;
    margin-top: 6px;
    display: none;
}

.card-footer { text-align: center; margin-top: 24px; font-size: 13px; color: var(--muted); }
.card-footer a { color: var(--gold); text-decoration: none; font-weight: 500; }
.card-footer a:hover { text-decoration: underline; }

@media (max-width: 560px) {
    .card { padding: 36px 22px; }
}
</style>
{% endblock %}

{% block body %}
<div class="wrap">
    <a href="{{ path('app_login') }}" class="back-link">← Retour à la connexion</a>

    <div class="card">

        <div class="card-logo">
            <img src="{{ asset('images/logo.png') }}" alt="Harmony">
            <span>Harmony</span>
        </div>

        {# ════════════════════════════════════════
           ÉTAPE 1 — Email
        ════════════════════════════════════════ #}
        {% if step == 'email' %}

        <div class="steps">
            <div class="step-dot active">1</div>
            <div class="step-line"></div>
            <div class="step-dot idle">2</div>
            <div class="step-line"></div>
            <div class="step-dot idle">3</div>
        </div>

        <h2 class="card-title">Mot de passe oublié</h2>
        <p class="card-sub">Entrez votre adresse email pour commencer la récupération via votre application Authenticator.</p>

        <form method="post" action="{{ path('app_forgot_password') }}">
            <div class="form-group">
                <label for="email">Adresse email du compte</label>
                <div class="input-wrap">
                    <span class="input-icon">✉</span>
                    <input type="email" id="email" name="email" required autofocus
                           placeholder="votre@email.com" autocomplete="email">
                </div>
            </div>
            <button type="submit" class="btn-submit">Continuer →</button>
        </form>

        {# ════════════════════════════════════════
           ÉTAPE 2 — QR Code + Code TOTP
        ════════════════════════════════════════ #}
        {% elseif step == 'verify' %}

        <div class="steps">
            <div class="step-dot done">✓</div>
            <div class="step-line done"></div>
            <div class="step-dot active">2</div>
            <div class="step-line"></div>
            <div class="step-dot idle">3</div>
        </div>

        {% if error is defined and error %}
            <div class="alert alert-error">⚠ {{ error }}</div>
        {% endif %}

        {% if isNew and qrUri is defined and qrUri %}
            {# ── Première configuration : afficher le QR à scanner ── #}
            <h2 class="card-title">Configurer l'Authenticator</h2>
            <p class="card-sub">Scannez ce QR code avec <strong>Google Authenticator</strong> ou <strong>Authy</strong>, puis entrez le code à 6 chiffres.</p>

            <div class="qr-block">
                <h3>📲 Scanner ce QR code</h3>
                <p>Ouvrez votre application Authenticator et scannez le code ci-dessous.</p>
                <div class="qr-canvas-wrap">
                    <div id="qrcode"></div>
                </div>
                <ul class="qr-steps">
                    <li>
                        <span class="step-num">1</span>
                        <span>Ouvrez <strong>Google Authenticator</strong> ou <strong>Authy</strong></span>
                    </li>
                    <li>
                        <span class="step-num">2</span>
                        <span>Appuyez sur <strong>+</strong> → <strong>Scanner un QR code</strong></span>
                    </li>
                    <li>
                        <span class="step-num">3</span>
                        <span>Scannez — une entrée <strong>Harmony</strong> apparaîtra</span>
                    </li>
                    <li>
                        <span class="step-num">4</span>
                        <span>Entrez ci-dessous le <strong>code à 6 chiffres</strong> affiché</span>
                    </li>
                </ul>
            </div>

        {% else %}
            {# ── Secret déjà configuré : demander directement le code ── #}
            <h2 class="card-title">Vérification Authenticator</h2>
            <p class="card-sub">Ouvrez votre application Authenticator et entrez le code à 6 chiffres affiché pour <strong>{{ email }}</strong>.</p>
        {% endif %}

        <form method="post" action="{{ path('app_forgot_password_verify') }}">
            <div class="totp-wrap">
                <label>Code à 6 chiffres</label>
                <input type="text" name="totp_code" class="totp-input"
                       id="totpInput"
                       required autofocus
                       placeholder="000000"
                       maxlength="6"
                       inputmode="numeric"
                       pattern="\d{6}"
                       autocomplete="one-time-code">
                <div class="totp-timer">
                    <svg class="timer-svg" width="20" height="20" viewBox="0 0 20 20">
                        <circle class="timer-bg" cx="10" cy="10" r="8"/>
                        <circle class="timer-prog" id="timerCircle" cx="10" cy="10" r="8" stroke-dashoffset="0"/>
                    </svg>
                    <span id="timerLabel">Calcul en cours…</span>
                </div>
            </div>
            <button type="submit" class="btn-submit">Vérifier le code →</button>
        </form>

        {# ════════════════════════════════════════
           ÉTAPE 3 — Nouveau mot de passe
        ════════════════════════════════════════ #}
        {% elseif step == 'reset' %}

        <div class="steps">
            <div class="step-dot done">✓</div>
            <div class="step-line done"></div>
            <div class="step-dot done">✓</div>
            <div class="step-line done"></div>
            <div class="step-dot active">3</div>
        </div>

        <h2 class="card-title">Nouveau mot de passe</h2>
        <p class="card-sub">Choisissez un mot de passe fort pour votre compte <strong>{{ email }}</strong>.</p>

        {% if errors is defined and errors %}
            {% for err in errors %}
                <div class="alert alert-error">⚠ {{ err }}</div>
            {% endfor %}
        {% endif %}

        <form method="post" action="{{ path('app_forgot_password_reset') }}" id="resetForm">

            <div class="form-group">
                <label for="new_password">Nouveau mot de passe</label>
                <div class="input-wrap">
                    <span class="input-icon">🔑</span>
                    <input type="password" id="new_password" name="new_password"
                           required placeholder="••••••••" autocomplete="new-password">
                </div>
                <div class="pwd-strength">
                    <div class="pwd-bars">
                        <div class="pwd-bar" id="bar1"></div>
                        <div class="pwd-bar" id="bar2"></div>
                        <div class="pwd-bar" id="bar3"></div>
                        <div class="pwd-bar" id="bar4"></div>
                    </div>
                    <div class="strength-lbl" id="strengthLabel"></div>
                    <div class="pwd-rules">
                        <div class="pwd-rule" id="r-len">8 caractères min</div>
                        <div class="pwd-rule" id="r-maj">1 majuscule</div>
                        <div class="pwd-rule" id="r-num">1 chiffre</div>
                        <div class="pwd-rule" id="r-sym">1 caractère spécial</div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="confirm_password">Confirmer le mot de passe</label>
                <div class="input-wrap">
                    <span class="input-icon">🔒</span>
                    <input type="password" id="confirm_password" name="confirm_password"
                           required placeholder="••••••••" autocomplete="new-password">
                </div>
                <div class="match-error" id="matchError">⚠ Les mots de passe ne correspondent pas.</div>
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">
                Enregistrer le nouveau mot de passe ✓
            </button>
        </form>

        {% endif %}

        <div class="card-footer">
            <a href="{{ path('app_login') }}">← Retour à la connexion</a>
        </div>
    </div>
</div>
{% endblock %}

{% block body_javascripts %}
{# Librairie QR code JS - chargée via CDN, aucune installation requise #}
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

<script>
// ═══════════════════════════════════════════════════════════
// QR CODE — généré côté client via qrcodejs
// ═══════════════════════════════════════════════════════════
(function() {
    const container = document.getElementById('qrcode');
    {% if step == 'verify' and isNew is defined and isNew and qrUri is defined and qrUri %}
    if (container && typeof QRCode !== 'undefined') {
        new QRCode(container, {
            text: {{ qrUri|json_encode|raw }},
            width:  160,
            height: 160,
            colorDark:  '#000000',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.M
        });
    }
    {% endif %}
})();

// ═══════════════════════════════════════════════════════════
// TIMER TOTP — tourne en temps réel
// ═══════════════════════════════════════════════════════════
(function() {
    const circle = document.getElementById('timerCircle');
    const label  = document.getElementById('timerLabel');
    if (!circle) return;

    const circumference = 2 * Math.PI * 8; // ≈ 50.27

    function tick() {
        const elapsed = Math.floor(Date.now() / 1000) % 30;
        const left    = 30 - elapsed;
        const offset  = circumference * (elapsed / 30);
        circle.style.strokeDashoffset = offset;
        circle.style.stroke = left <= 5 ? '#e07070' : 'var(--gold)';
        if (label) label.textContent = 'Code valide encore ' + left + ' secondes';
    }
    tick();
    setInterval(tick, 1000);
})();

// ═══════════════════════════════════════════════════════════
// TOTP INPUT — chiffres uniquement, 6 max
// ═══════════════════════════════════════════════════════════
(function() {
    const input = document.getElementById('totpInput');
    if (!input) return;
    input.addEventListener('input', function() {
        this.value = this.value.replace(/\D/g, '').slice(0, 6);
    });
})();

// ═══════════════════════════════════════════════════════════
// INDICATEUR DE FORCE DU MOT DE PASSE
// ═══════════════════════════════════════════════════════════
(function() {
    const pwd  = document.getElementById('new_password');
    const conf = document.getElementById('confirm_password');
    if (!pwd) return;

    const rules = {
        len: v => v.length >= 8,
        maj: v => /[A-Z]/.test(v),
        num: v => /\d/.test(v),
        sym: v => /[\W_]/.test(v),
    };
    const colors = ['#e07070', '#f59e0b', '#6ee7b7', '#c9a96e'];
    const labels = ['', '🔴 Faible', '🟠 Moyen', '🟢 Fort', '💪 Très fort'];

    pwd.addEventListener('input', function() {
        const v     = this.value;
        const score = Object.values(rules).filter(fn => fn(v)).length;

        // Barres de force
        ['bar1','bar2','bar3','bar4'].forEach(function(id, i) {
            const bar = document.getElementById(id);
            if (bar) bar.style.background = i < score ? colors[score - 1] : 'rgba(255,255,255,.08)';
        });

        // Label textuel
        const lbl = document.getElementById('strengthLabel');
        if (lbl) {
            lbl.textContent = v.length ? (labels[score] || labels[1]) : '';
            lbl.style.color = v.length ? colors[Math.max(0, score - 1)] : '';
        }

        // Règles individuelles
        Object.entries(rules).forEach(function(entry) {
            const el = document.getElementById('r-' + entry[0]);
            if (el) el.classList.toggle('ok', entry[1](v));
        });
    });

    // Vérification correspondance
    if (conf) {
        conf.addEventListener('input', checkMatch);
        conf.addEventListener('blur',  checkMatch);
    }

    function checkMatch() {
        const err = document.getElementById('matchError');
        if (err) {
            const mismatch = conf.value.length > 0 && conf.value !== pwd.value;
            err.style.display = mismatch ? 'block' : 'none';
        }
    }

    // Bloquer la soumission si les mots de passe ne correspondent pas
    const form = document.getElementById('resetForm');
    if (form) {
        form.addEventListener('submit', function(e) {
            if (pwd.value !== conf.value) {
                e.preventDefault();
                const err = document.getElementById('matchError');
                if (err) err.style.display = 'block';
                conf.focus();
            }
        });
    }
})();
</script>
{% endblock %}
