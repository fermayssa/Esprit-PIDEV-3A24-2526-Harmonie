{% extends 'base.html.twig' %}

{% block title %}Connexion — Harmony{% endblock %}

{% block content %}
<div style="max-width:420px;margin:48px auto;padding:32px;background:#fff;border-radius:18px;border:1px solid rgba(106,90,205,.15);box-shadow:0 8px 32px rgba(106,90,205,.1);">
    <h1 style="font-family:var(--font-head,'Syne',sans-serif);font-size:1.5rem;margin:0 0 8px;">Connexion</h1>
    <p style="color:var(--text-muted);font-size:14px;margin:0 0 24px;">Accès réservé aux comptes administrateur pour /admin.</p>

    {% if error %}
        <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <div style="margin-bottom:16px;">
            <label for="email" style="display:block;font-size:13px;font-weight:600;margin-bottom:6px;">E-mail</label>
            <input type="email" id="email" name="email" value="{{ last_username }}" required autofocus
                   class="harmony-input" style="width:100%;box-sizing:border-box;padding:10px 12px;border-radius:10px;border:1px solid #e5e7eb;">
        </div>
        <div style="margin-bottom:20px;">
            <label for="password" style="display:block;font-size:13px;font-weight:600;margin-bottom:6px;">Mot de passe</label>
            <input type="password" id="password" name="password" required
                   class="harmony-input" style="width:100%;box-sizing:border-box;padding:10px 12px;border-radius:10px;border:1px solid #e5e7eb;">
        </div>
        <button type="submit" class="harmony-btn-submit" style="width:100%;padding:12px;border:none;border-radius:12px;background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff;font-weight:700;cursor:pointer;">
            Se connecter
        </button>
    </form>
</div>
{% endblock %}
