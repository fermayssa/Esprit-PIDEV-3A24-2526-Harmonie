{% extends 'base.html.twig' %}

{% block title %}Etudiant index{% endblock %}

{% block content %}
    <h1>Etudiant index</h1>

    <table class="table table-bordered table-hover w-100">
        <thead>
            <tr>
                <th>IdEtudiant</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>Email</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for etudiant in etudiants %}
            <tr>
                <td>{{ etudiant.idEtudiant }}</td>
                <td>{{ etudiant.nom }}</td>
                <td>{{ etudiant.prenom }}</td>
                <td>{{ etudiant.email }}</td>
                <td>
                    <a href="{{ path('app_etudiant_show', {'idEtudiant': etudiant.idEtudiant}) }}">show</a>
                    <a href="{{ path('app_etudiant_edit', {'idEtudiant': etudiant.idEtudiant}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_etudiant_new') }}">Create new</a>
{% endblock %}
