{% extends 'base.html.twig' %}

{% block title %}Tableau de bord · Harmony{% endblock %}

{% block content %}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Tableau de bord</h1>
</div>
<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card shadow">
            <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Bienvenue</h6></div>
            <div class="card-body">
                <p>Back-office Symfony aligné sur la base <code>integration-pi2</code> (tables JavaFX / Harmony).</p>
                <p class="mb-0">Utilisez la barre latérale pour accéder aux listes CRUD.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-4">
        <div class="card shadow">
            <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Raccourcis</h6></div>
            <div class="card-body">
                <a href="{{ path('app_user_index') }}" class="btn btn-primary btn-sm mb-1">user</a>
                <a href="{{ path('app_post_index') }}" class="btn btn-info btn-sm mb-1">post</a>
                <a href="{{ path('app_courses_index') }}" class="btn btn-success btn-sm mb-1">courses</a>
                <a href="{{ path('app_evenement_index') }}" class="btn btn-warning btn-sm mb-1">evenement</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
