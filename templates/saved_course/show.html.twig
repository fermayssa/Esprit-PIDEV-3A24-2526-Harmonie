{% extends 'base.html.twig' %}

{% block title %}SavedCourse{% endblock %}

{% block content %}
    <h1>SavedCourse</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ saved_course.id }}</td>
            </tr>
            <tr>
                <th>UserId</th>
                <td>{{ saved_course.userId }}</td>
            </tr>
            <tr>
                <th>CourseId</th>
                <td>{{ saved_course.courseId }}</td>
            </tr>
            <tr>
                <th>SavedAt</th>
                <td>{{ saved_course.savedAt ? saved_course.savedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_saved_course_index') }}">back to list</a>

    <a href="{{ path('app_saved_course_edit', {'id': saved_course.id}) }}">edit</a>

    {{ include('saved_course/_delete_form.html.twig') }}
{% endblock %}
