{% form_theme form 'form_div_layout.html.twig' %}
{% if panel_mode == 'edit' and entity is defined and entity %}
    {% set form_action = path('app_evenement_edit', { id: entity.id }) %}
{% else %}
    {% set form_action = path('app_evenement_new') %}
{% endif %}

{{ form_start(form, {
    action: form_action,
    attr: {
        class: 'harmony-panel-form harmony-form',
        id: 'evenement-panel-form',
        autocomplete: 'off'
    }
}) }}
    {{ form_errors(form) }}

    <div class="harmony-panel-visible-fields">
        {{ form_row(form.titre, { label: 'Titre' }) }}
        {{ form_row(form.dateDebut, { label: 'Date début' }) }}
        {{ form_row(form.dateFin, { label: 'Date fin' }) }}
        {{ form_row(form.eventType) }}
        <div class="harmony-event-type-icon-wrap" aria-hidden="true">
            <span class="js-event-type-icon harmony-type-icon harmony-panel-type-icon"></span>
        </div>
        {{ form_row(form.lieuType) }}
        <div class="js-evenement-presentiel-zone harmony-presentiel-zone" aria-hidden="true">
            {{ form_row(form.lieuAdresse) }}
            {{ form_row(form.salle) }}
        </div>
    </div>

    <div class="harmony-panel-sr-hidden" aria-hidden="true">
        {% for child in form %}
            {% if not child.rendered and child.vars.name != 'submit' %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    </div>

    <div class="harmony-panel-actions">
        <button type="button" class="harmony-panel-cancel js-harmony-panel-cancel">Annuler</button>
        {{ form_row(form.submit, {
            label: 'Enregistrer',
            attr: { class: 'harmony-panel-submit harmony-btn-submit' }
        }) }}
    </div>
{{ form_end(form, { render_rest: false }) }}
