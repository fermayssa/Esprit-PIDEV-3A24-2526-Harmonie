{% extends 'base.html.twig' %}

{% block title %}CourseReport{% endblock %}

{% block content %}
    <h1>CourseReport</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ course_report.id }}</td>
            </tr>
            <tr>
                <th>CourseId</th>
                <td>{{ course_report.courseId }}</td>
            </tr>
            <tr>
                <th>ReporterId</th>
                <td>{{ course_report.reporterId }}</td>
            </tr>
            <tr>
                <th>Reason</th>
                <td>{{ course_report.reason }}</td>
            </tr>
            <tr>
                <th>Details</th>
                <td>{{ course_report.details }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ course_report.status }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ course_report.createdAt ? course_report.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_course_report_index') }}">back to list</a>

    <a href="{{ path('app_course_report_edit', {'id': course_report.id}) }}">edit</a>

    {{ include('course_report/_delete_form.html.twig') }}
{% endblock %}
