{% extends 'base.html.twig' %}

{% block title %}Tache{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('harmonie/css/harmony-theme.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
{% include '_planning_topbar.html.twig' %}
<main class="page">
    <h1>Tache</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ tache.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ tache.nom }}</td>
            </tr>
            <tr>
                <th>Deadline</th>
                <td>{{ tache.deadline ? tache.deadline|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Notes</th>
                <td>{{ tache.notes }}</td>
            </tr>
            <tr>
                <th>StatutTache</th>
                <td>{{ tache.statutTache }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_tache_index') }}">back to list</a>

    <a href="{{ path('app_tache_edit', {'id': tache.id}) }}">edit</a>

    {{ include('tache/_delete_form.html.twig') }}
</main>
{% endblock %}
