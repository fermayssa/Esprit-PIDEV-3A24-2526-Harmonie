{% extends 'base.html.twig' %}

{% block title %}Tache index{% endblock %}

{% block content %}
    <h1>Tache index</h1>

    <table class="table table-bordered table-hover w-100">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Deadline</th>
                <th>Notes</th>
                <th>StatutTache</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for tache in taches %}
            <tr>
                <td>{{ tache.id }}</td>
                <td>{{ tache.nom }}</td>
                <td>{{ tache.deadline ? tache.deadline|date('Y-m-d') : '' }}</td>
                <td>{{ tache.notes }}</td>
                <td>{{ tache.statutTache }}</td>
                <td>
                    <a href="{{ path('app_tache_show', {'id': tache.id}) }}">show</a>
                    <a href="{{ path('app_tache_edit', {'id': tache.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_tache_new') }}">Create new</a>
{% endblock %}
