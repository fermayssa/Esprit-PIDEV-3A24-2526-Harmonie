{% extends 'base.html.twig' %}

{% block title %}Activite{% endblock %}

{% block content %}
    <h1>Activite</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>IdActivite</th>
                <td>{{ activite.idActivite }}</td>
            </tr>
            <tr>
                <th>DateActivite</th>
                <td>{{ activite.dateActivite ? activite.dateActivite|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DureeMinutes</th>
                <td>{{ activite.dureeMinutes }}</td>
            </tr>
            <tr>
                <th>CaloriesBrulees</th>
                <td>{{ activite.caloriesBrulees }}</td>
            </tr>
            <tr>
                <th>NbSeries</th>
                <td>{{ activite.nbSeries }}</td>
            </tr>
            <tr>
                <th>NbRepetitions</th>
                <td>{{ activite.nbRepetitions }}</td>
            </tr>
            <tr>
                <th>Poids</th>
                <td>{{ activite.poids }}</td>
            </tr>
            <tr>
                <th>Notes</th>
                <td>{{ activite.notes }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_activite_index') }}">back to list</a>

    <a href="{{ path('app_activite_edit', {'idActivite': activite.idActivite}) }}">edit</a>

    {{ include('activite/_delete_form.html.twig') }}
{% endblock %}
