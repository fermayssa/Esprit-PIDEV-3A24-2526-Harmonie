{% extends 'base.html.twig' %}

{% block title %}Courses index{% endblock %}

{% block content %}
    <h1>Courses index</h1>

    <table class="table table-bordered table-hover w-100">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>CreatedAt</th>
                <th>IsPublished</th>
                <th>CoverImagePath</th>
                <th>Saves</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for course in courses %}
            <tr>
                <td>{{ course.id }}</td>
                <td>{{ course.title }}</td>
                <td>{{ course.createdAt ? course.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ course.isPublished ? 'Yes' : 'No' }}</td>
                <td>{{ course.coverImagePath }}</td>
                <td>{{ course.saves }}</td>
                <td>
                    <a href="{{ path('app_courses_show', {'id': course.id}) }}">show</a>
                    <a href="{{ path('app_courses_edit', {'id': course.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_courses_new') }}">Create new</a>
{% endblock %}
