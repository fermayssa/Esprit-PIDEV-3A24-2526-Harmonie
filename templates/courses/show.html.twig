{% extends 'base.html.twig' %}

{% block title %}Courses{% endblock %}

{% block content %}
    <h1>Courses</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ course.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ course.title }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ course.createdAt ? course.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>IsPublished</th>
                <td>{{ course.isPublished ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CoverImagePath</th>
                <td>{{ course.coverImagePath }}</td>
            </tr>
            <tr>
                <th>Saves</th>
                <td>{{ course.saves }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_courses_index') }}">back to list</a>

    <a href="{{ path('app_courses_edit', {'id': course.id}) }}">edit</a>

    {{ include('courses/_delete_form.html.twig') }}
{% endblock %}
