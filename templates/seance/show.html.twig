{% extends 'base.html.twig' %}

{% block title %}Seance{% endblock %}

{% block content %}
    <h1>Seance</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ seance.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ seance.titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ seance.description }}</td>
            </tr>
            <tr>
                <th>DateDebut</th>
                <td>{{ seance.dateDebut ? seance.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DateFin</th>
                <td>{{ seance.dateFin ? seance.dateFin|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Confirmee</th>
                <td>{{ seance.confirmee ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>TypeSeance</th>
                <td>{{ seance.typeSeance }}</td>
            </tr>
            <tr>
                <th>NombreParticipants</th>
                <td>{{ seance.nombreParticipants }}</td>
            </tr>
            <tr>
                <th>DateCreation</th>
                <td>{{ seance.dateCreation ? seance.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_seance_index') }}">back to list</a>

    <a href="{{ path('app_seance_edit', {'id': seance.id}) }}">edit</a>

    {{ include('seance/_delete_form.html.twig') }}
{% endblock %}
