{% extends 'base.html.twig' %}

{% block title %}Seance index{% endblock %}

{% block content %}
    <h1>Seance index</h1>

    <table class="table table-bordered table-hover w-100">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Description</th>
                <th>DateDebut</th>
                <th>DateFin</th>
                <th>Confirmee</th>
                <th>TypeSeance</th>
                <th>NombreParticipants</th>
                <th>DateCreation</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for seance in seances %}
            <tr>
                <td>{{ seance.id }}</td>
                <td>{{ seance.titre }}</td>
                <td>{{ seance.description }}</td>
                <td>{{ seance.dateDebut ? seance.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ seance.dateFin ? seance.dateFin|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ seance.confirmee ? 'Yes' : 'No' }}</td>
                <td>{{ seance.typeSeance }}</td>
                <td>{{ seance.nombreParticipants }}</td>
                <td>{{ seance.dateCreation ? seance.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_seance_show', {'id': seance.id}) }}">show</a>
                    <a href="{{ path('app_seance_edit', {'id': seance.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_seance_new') }}">Create new</a>
{% endblock %}
