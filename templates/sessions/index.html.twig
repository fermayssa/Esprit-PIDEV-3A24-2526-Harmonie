{% extends 'base.html.twig' %}

{% block title %}Sessions index{% endblock %}

{% block content %}
    <h1>Sessions index</h1>

    <table class="table table-bordered table-hover w-100">
        <thead>
            <tr>
                <th>SessionId</th>
                <th>Token</th>
                <th>ExpiresAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for session in sessions %}
            <tr>
                <td>{{ session.sessionId }}</td>
                <td>{{ session.token }}</td>
                <td>{{ session.expiresAt ? session.expiresAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_sessions_show', {'sessionId': session.sessionId}) }}">show</a>
                    <a href="{{ path('app_sessions_edit', {'sessionId': session.sessionId}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_sessions_new') }}">Create new</a>
{% endblock %}
