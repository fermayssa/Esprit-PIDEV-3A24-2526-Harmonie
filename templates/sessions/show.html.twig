{% extends 'base.html.twig' %}

{% block title %}Sessions{% endblock %}

{% block content %}
    <h1>Sessions</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>SessionId</th>
                <td>{{ session.sessionId }}</td>
            </tr>
            <tr>
                <th>Token</th>
                <td>{{ session.token }}</td>
            </tr>
            <tr>
                <th>ExpiresAt</th>
                <td>{{ session.expiresAt ? session.expiresAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_sessions_index') }}">back to list</a>

    <a href="{{ path('app_sessions_edit', {'sessionId': session.sessionId}) }}">edit</a>

    {{ include('sessions/_delete_form.html.twig') }}
{% endblock %}
